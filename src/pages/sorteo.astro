---
import RandomWinner from "@/components/raffle/RandomWinner"
import SorteoHeader from "@/components/raffle/SorteoHeader.astro"
import BaseLayout from "@/layout/BaseLayout.astro"
import { getProfile, getStaffRoles } from "@/lib/services/profileService"
import { fetchRaffleEvents } from "@/lib/services/raffleService"
import { createUserClient } from "@/lib/supabase"

const supabase = await createUserClient(Astro.cookies)
const profile = await getProfile(supabase)
const staffRoles = profile && !profile.is_admin ? await getStaffRoles(supabase, profile.id) : {}
if (!profile || (!profile.is_admin && Object.keys(staffRoles).length === 0)) {
  return Astro.redirect("/")
}
const events = await fetchRaffleEvents(
  supabase,
  profile.is_admin ? undefined : Object.keys(staffRoles)
)
---

<BaseLayout title="Sorteos · GDG Sucre">
  <SorteoHeader />
  <main class="flex-1 bg-background text-foreground">
    <RandomWinner events={events} client:load />
  </main>
</BaseLayout>
