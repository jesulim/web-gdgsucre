---
import About from "@/components/events/devfest-26/About.astro"
import Agenda from "@/components/events/devfest-26/agenda/Agenda.astro"
import { DEVFEST_26_AGENDA_SLOTS } from "@/components/events/devfest-26/agenda/agendaData"
import Footer from "@/components/events/devfest-26/Footer.astro"
import Header from "@/components/events/devfest-26/Header.astro"
import Hero from "@/components/events/devfest-26/Hero.astro"
import Organizers from "@/components/events/devfest-26/organizers/Organizers.astro"
import PackageSection from "@/components/events/devfest-26/PackageSection.astro"
import Sponsors from "@/components/events/devfest-26/Sponsors.astro"
import Speakers from "@/components/events/devfest-26/speakers/Speakers.astro"

import BaseLayout from "@/layout/BaseLayout.astro"
---

<BaseLayout
  theme="dark"
  title="DevFest Sucre 2026"
  description="Devfest es la conferencia tecnológica más grande impulsada por las comunidades Google Developer Groups de todo el mundo."
  ogImage="/events/devfest-26/og.webp"
>
  <Header />

  <main class="flex-1">
    <Hero />
    <About />
    <PackageSection />
    <Speakers />
    <Agenda slots={DEVFEST_26_AGENDA_SLOTS} />
    <Sponsors />
    <Organizers />
  </main>

  <Footer />
</BaseLayout>
