---
import Footer from "@/components/landing/Footer.astro"
import Header from "@/components/landing/Header.astro"
import ScrambledText from "@/components/landing/ScrambledText.astro"
import { ProfileForm } from "@/components/profile/ProfileForm"

import BaseLayout from "@/layout/BaseLayout.astro"

import { getBadges } from "@/lib/services/badgesService"
import { getProfile } from "@/lib/services/profileService"
import { createUserClient } from "@/lib/supabase"

const supabase = await createUserClient(Astro.cookies)
const profile = await getProfile(supabase)

if (!profile) {
  return Astro.redirect("/api/auth/signin?next=/perfil")
}

const badges = await getBadges(supabase, profile.id)
---

<BaseLayout theme="light" title="Perfil - GDG Sucre" description="Editar perfil">
  <Header />

  <main class="flex-1 overflow-x-hidden mt-16">
    <div class="mx-auto p-4 flex flex-col gap-4 max-w-lg">
      <div class="flex gap-2 items-baseline">
        <ScrambledText text="Mi perfil" />
        <span class="w-3 h-1 bg-green-500"></span>
      </div>

      <h1 class="text-3xl font-medium">Edita tu información</h1>

      <ProfileForm profile={profile} client:load />

      <div class="flex gap-2 items-baseline mt-4">
        <ScrambledText text="Insignias" />
        <span class="w-3 h-1 bg-yellow-500"></span>
      </div>

      <h1 class="text-3xl font-medium">Eventos en los que participaste</h1>

      {
        badges?.length == 0 && (
          <p class="leading-relaxed text-muted-foreground font-normal">
            Aún no has participado en ninguno. <br />
            ¡Te esperamos en nuestro próximo evento!
          </p>
        )
      }

      <div class="grid grid-cols-3 gap-8 my-2">
        {
          badges?.map(badge => (
            <div class="grid place-items-center gap-2">
              <img
                src={badge.image_url}
                alt={badge.name}
                width="120"
                height="120"
                class="rounded-full border-2 border-gray-400"
              />
              <span class="text-center text-sm">{badge.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
