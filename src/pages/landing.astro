---
import ConsoleBanner from "@/components/landing/ConsoleBanner.astro"
import Featured from "@/components/landing/Featured.astro"
import Footer from "@/components/landing/Footer.astro"
import Header from "@/components/landing/Header.astro"
import Hero from "@/components/landing/Hero.astro"
import Info from "@/components/landing/Info.astro"

import BaseLayout from "@/layout/BaseLayout.astro"
---

<BaseLayout enableThemePreference title="GDG Sucre" description="GDG Sucre">
  <Header />
  <main class="flex-1 overflow-x-hidden mt-16">
    <Hero />
    <Info />
    <Featured />
  </main>
  <Footer />
  <ConsoleBanner />
</BaseLayout>

<style is:global>
  :where(a, button, [role="button"]):focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
