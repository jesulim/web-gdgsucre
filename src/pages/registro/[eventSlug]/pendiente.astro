---
import { ConfettiEffect } from "@/components/ConfettiEffect"
// import IoExtendedHeader from "@/components/events/io-extended-26/Header.astro"
import NwdHeader from "@/components/events/nwd-26/Header.astro"
import BaseLayout from "@/layout/BaseLayout.astro"

import { getEventData } from "@/lib/eventData"
import { getProfile } from "@/lib/services/profileService"
import { getEventRegistration } from "@/lib/services/registrationService"
import { createUserClient } from "@/lib/supabase"

const supabase = await createUserClient(Astro.cookies)

const profile = await getProfile(supabase)
if (!profile) return Astro.redirect("/")

const eventSlug = Astro.params.eventSlug || ""
const { whatsappLink } = getEventData(eventSlug)

const registration = await getEventRegistration(supabase, profile?.id, eventSlug)

if (registration?.status !== "pending") return Astro.redirect("/")
---

<BaseLayout theme="light">
  <NwdHeader />
  <ConfettiEffect client:load />
  <main class="bg-nwd-paper flex flex-1 py-8 sm:py-12 text-nwd-ink">
    <div class="mx-auto w-full max-w-lg px-4">
      <h1 class="text-xl mb-4">¡Hola, {profile?.first_name}!</h1>
      <p>
        Estamos procesando tu registro, Revisa tu correo donde te informaremos cuando haya sido
        validado.
        <br />
        Mientras esperas, te invitamos a nuestra
        <a
          href={whatsappLink}
          class="text-nwd-teal font-medium underline">Comunidad en WhatsApp</a
        >
      </p>
    </div>
  </main>
</BaseLayout>
