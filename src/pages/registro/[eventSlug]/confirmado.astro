---
import CredentialCardByEvent from "@/components/events/CredentialCardByEvent"
import Header from "@/components/events/devfest-26/Header.astro"
import Footer from "@/components/landing/Footer.astro"

import BaseLayout from "@/layout/BaseLayout.astro"

import { getProfile } from "@/lib/services/profileService"
import { getEventRegistration } from "@/lib/services/registrationService"
import { createSupabaseServerClient } from "@/lib/supabase"

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies })
const profile = await getProfile(supabase)
if (!profile) return Astro.redirect("/")

const eventSlug = Astro.params.eventSlug || "bwai-26"
const registration = await getEventRegistration(supabase, profile?.id, eventSlug)
if (!registration) return Astro.redirect("/")

if (registration?.status !== "confirmed") return Astro.redirect(`/registro/${eventSlug}`)

const cardProps = {
  avatarUrl: profile.avatar_url,
  name: profile.display_name || `${profile.first_name} ${profile.last_name}`,
  firstName: profile.first_name,
  lastName: profile.last_name,
  role: registration.role || "Asistente",
  enableTilt: true,
  enableMobileTilt: false,
  grainUrl: "/grain.webp",
  qrUrl: registration?.qr_url,
}
---

<BaseLayout theme="dark">
  <Header showNav={false} />
  <main class="flex-1 pt-16 md:pt-24 text-white pb-12">
    <CredentialCardByEvent client:load eventSlug={eventSlug} {...cardProps} />
  </main>
  <Footer />
</BaseLayout>
