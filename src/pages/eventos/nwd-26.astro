---
import About from "@/components/events/nwd-26/About.astro"
import Contador from "@/components/events/nwd-26/Contador.astro"
import Footer from "@/components/events/nwd-26/Footer.astro"
import Header from "@/components/events/nwd-26/Header.astro"
import Hero from "@/components/events/nwd-26/Hero.astro"
import PackageSection from "@/components/events/nwd-26/PackageSection.astro"
import PastEvents from "@/components/events/nwd-26/PastEvents.astro"
import PixelBlocks from "@/components/events/nwd-26/PixelBlocks.astro"
import BaseLayout from "@/layout/BaseLayout.astro"
---

<BaseLayout
  title="WTM Sucre · En Ellas Late Bolivia"
  description="Mujeres que impulsan. Sábado 10 de octubre a las 14:00 en la Facultad de Ciencias y Tecnología, Sucre. Women Techmakers Sucre."
  ogImage="/events/nwd-26/og-nwd.png"
  theme="light"
>
  <Header
    sections={[
      { href: "#inicio", label: "Inicio" },
      { href: "#sobre-el-evento", label: "Sobre el evento" },
    ]}
  />
  <main class="relative flex-1 bg-[#FAFCFF]">
    <PixelBlocks />
    <div class="relative z-[1] -mt-[100vh]">
      <Hero />
      <Contador />
      <About />
      <PackageSection />
      <PastEvents />
    </div>
  </main>
  <Footer />
</BaseLayout>
