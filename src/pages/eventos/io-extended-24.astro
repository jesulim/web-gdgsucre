---
import About from "@/components/events/io-extended-24/About.astro"
import Agenda from "@/components/events/io-extended-24/Agenda.astro"
import Footer from "@/components/events/io-extended-24/Footer.astro"
import Header from "@/components/events/io-extended-24/Header.astro"
import Hero from "@/components/events/io-extended-24/Hero.astro"
import OrganizerProfiles from "@/components/events/io-extended-24/OrganizerProfiles.astro"
import Speakers from "@/components/events/io-extended-24/Speakers.astro"
import BaseLayout from "@/layout/BaseLayout.astro"
---

<BaseLayout
  title="Google I/O Extended Sucre 2024 | GDG Sucre"
  description="Revive las novedades del Google I/O Extended Sucre 2024. Charlas sobre IA, Gemini, Android, Cloud, Web y workshops con expertos."
>
  <div class="io-extended-24-root font-sans text-[#202124] dark:text-white bg-white dark:bg-[#202124] min-h-screen flex flex-col bg-[linear-gradient(to_right,#eeeeee_1px,transparent_1px),linear-gradient(to_bottom,#eeeeee_1px,transparent_1px)] bg-[size:4rem_4rem] dark:bg-[linear-gradient(to_right,#444_1px,transparent_1px),linear-gradient(to_bottom,#444_1px,transparent_1px)] transition-colors duration-200">
    <Header />
    <main class="flex-1">
      <Hero />
      <About />
      <Speakers />
      <Agenda />
      <OrganizerProfiles />
    </main>
    <Footer />
  </div>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Prompt:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Sofia+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap');

  .io-extended-24-root {
    font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, "Noto Sans", sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
  }

  .io-extended-24-root .font-google,
  .io-extended-24-root .font-prompt {
    font-family: 'Prompt', sans-serif !important;
  }

  .io-extended-24-root .font-sofia {
    font-family: 'Sofia Sans', 'Sofia Sans Variable', sans-serif !important;
  }
</style>
