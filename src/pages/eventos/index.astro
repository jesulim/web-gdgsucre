---
import { Image } from "astro:assets"

import Bwai26 from "@/assets/events/bwai-26.webp"
import DevFest25 from "@/assets/events/devfest-25.webp"
import IoExtended25 from "@/assets/events/io-extended-25.webp"
import Footer from "@/components/landing/Footer.astro"
import Header from "@/components/landing/Header.astro"
import ScrambledText from "@/components/landing/ScrambledText.astro"
import BaseLayout from "@/layout/BaseLayout.astro"

const items = [
  {
    label: "Build with AI Sucre 2026",
    image: Bwai26,
    href: "/eventos/bwai-26",
  },
  {
    label: "DevFest Sucre 2025",
    image: DevFest25,
    href: "/eventos/devfest-25",
  },
  {
    label: "IO Extended Sucre 2025",
    image: IoExtended25,
    href: "/eventos/io-extended-25",
  },
]
---

<BaseLayout theme="light" title="GDG Sucre" description="GDG Sucre">
  <Header />

  <main class="flex-1 overflow-x-hidden mt-20">
    <div class="mx-auto p-4 flex flex-col gap-4 sm:px-8">
      <div class="flex gap-2 items-baseline">
        <ScrambledText text="Eventos pasados" />
        <span class="w-3 h-1 bg-yellow-500"></span>
      </div>

      <h1 class="text-3xl font-medium">Explora nuestros anteriores eventos</h1>

      <div
        class="grid border-t-2 border-l-2 *:border-r-2 *:border-b-2 *:border-off-white grid-cols-1 sm:grid-cols-2"
      >
        {
          items.map((item, index) => (
            <a href={item.href} class="p-4 sm:p-8 grid gap-4 justify-items-center">
              <Image src={item.image} alt={item.label} width={1920} height={1080} />
              <p class="text-lg font-medium">{item.label}</p>
            </a>
          ))
        }
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
