---
import CalendarHero from "@/components/calendar/CalendarHero.astro"
import Communities from "@/components/calendar/Communities.astro"
import { EventsCalendar } from "@/components/calendar/EventsCalendar"
import Footer from "@/components/calendar/Footer.astro"
import Header from "@/components/calendar/Header.astro"
import NextEvents from "@/components/calendar/NextEvents.astro"
import PublishEvent from "@/components/calendar/PublishEvent.astro"

import BaseLayout from "@/layout/BaseLayout.astro"
import { getUpcomingCalendarEvents } from "@/lib/services/calendarEventService"
import { getCommunitiesWithEventCount } from "@/lib/services/communityService"
import { createUserClient } from "@/lib/supabase"

const supabase = await createUserClient(Astro.cookies)

const [upcomingEvents, communities] = await Promise.all([
  getUpcomingCalendarEvents(supabase),
  getCommunitiesWithEventCount(supabase),
])
---

<BaseLayout
  theme="dark"
  title="La agenda tecnológica de Sucre · sucre.tech"
  description="Eventos de tecnología en Sucre. Descubre la agenda o publica tu evento."
  ogTitle="La agenda tecnológica de Sucre · sucre.tech"
  ogDescription="Eventos de tecnología en Sucre. Descubre la agenda o publica tu evento."
  ogImage="/og-calendario.webp"
>
  <Header />

  <main class="flex-1 overflow-x-hidden mt-8">
    <CalendarHero event={upcomingEvents[0]} />
    <hr class="border-t border-muted-foreground" />

    <NextEvents events={upcomingEvents} />
    <hr class="border-t border-muted-foreground" />

    <EventsCalendar client:visible />
    <hr class="border-t border-muted-foreground" />

    <PublishEvent />
    <hr class="border-t border-muted-foreground" />

    <Communities communities={communities} />
  </main>

  <Footer />
</BaseLayout>
