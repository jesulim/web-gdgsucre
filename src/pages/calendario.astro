---
import CalendarHero from "@/components/calendar/CalendarHero.astro"
import NextEvents from "@/components/calendar/NextEvents.astro"
import PublishHero from "@/components/calendar/PublishHero.astro"
import { SendEvent } from "@/components/calendar/SendEvent"
import Footer from "@/components/landing/Footer.astro"
import Header from "@/components/landing/Header.astro"

import BaseLayout from "@/layout/BaseLayout.astro"

import type { UpcomingCalendarEvent } from "@/lib/calendar"
import { getUpcomingCalendarEvents } from "@/lib/services/calendarEventService"
import { getProfile } from "@/lib/services/profileService"
import { createUserClient } from "@/lib/supabase"

const UPCOMING_LIMIT = 4

const supabase = await createUserClient(Astro.cookies)
const profile = await getProfile(supabase)

let upcomingEvents: UpcomingCalendarEvent[] = []
try {
  upcomingEvents = await getUpcomingCalendarEvents(supabase, UPCOMING_LIMIT)
} catch (error) {
  console.error("calendario: no se pudieron obtener los próximos eventos", error)
}
---

<BaseLayout theme="dark" title="Calendario - GDG Sucre" description="Publica tu evento en la agenda de comunidades de Sucre">
  <Header />

  <main class="flex-1 overflow-x-hidden mt-16">
    <CalendarHero event={upcomingEvents[0]} />

    <NextEvents events={upcomingEvents} />

    <div id="publicar" class="mx-auto grid max-w-6xl gap-12 px-4 py-16 lg:grid-cols-[2fr_3fr] lg:items-start lg:gap-20 lg:py-24">
      <div class="lg:sticky lg:top-24">
        <PublishHero />
      </div>

      <SendEvent isLoggedIn={!!profile} client:visible />
    </div>
  </main>

  <Footer />
</BaseLayout>
