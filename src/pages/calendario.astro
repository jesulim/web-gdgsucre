---
import CalendarHero from "@/components/calendar/CalendarHero.astro"
import { EventsCalendar } from "@/components/calendar/EventsCalendar"
import Footer from "@/components/calendar/Footer.astro"
import Header from "@/components/calendar/Header.astro"
import NextEvents from "@/components/calendar/NextEvents.astro"
import PublishEvent from "@/components/calendar/PublishEvent.astro"

import BaseLayout from "@/layout/BaseLayout.astro"

import { getUpcomingCalendarEvents } from "@/lib/services/calendarEventService"
import { createUserClient } from "@/lib/supabase"

const supabase = await createUserClient(Astro.cookies)
const upcomingEvents = await getUpcomingCalendarEvents(supabase)
---

<BaseLayout
  theme="dark"
  title="Calendario - GDG Sucre"
  description="Publica tu evento en la agenda de comunidades de Sucre"
>
  <Header />

  <main class="flex-1 overflow-x-hidden mt-16">
    <CalendarHero event={upcomingEvents[0]} />
    <NextEvents events={upcomingEvents} />
    <EventsCalendar client:visible />
    <PublishEvent />
  </main>

  <Footer />
</BaseLayout>
