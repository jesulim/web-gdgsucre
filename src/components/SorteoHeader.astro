---
import { Image } from "astro:assets"
import LogoHorizontalBlack from "@/assets/logos/LogoHorizontalBlack.png"
---
<header class="border-b border-border bg-background px-4 sm:px-8">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-3 sm:py-4">
    <a href="/" aria-label="GDG Sucre, inicio">
      <Image src={LogoHorizontalBlack} alt="GDG Sucre" width={240} class="h-auto w-36 sm:w-44 dark:brightness-0 dark:invert" />
    </a>
    <a href="/admin" class="inline-flex min-h-11 items-center gap-2 text-sm hover:underline">
      Administración <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
