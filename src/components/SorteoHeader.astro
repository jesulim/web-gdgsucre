---
import { Image } from "astro:assets"
import LogoHorizontalBlack from "@/assets/logos/LogoHorizontalBlack.png"
---
<header class="border-b border-border bg-background px-4 sm:px-6">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 py-5">
    <a href="/" aria-label="GDG Sucre, inicio">
      <Image src={LogoHorizontalBlack} alt="GDG Sucre" width={240} class="h-auto w-44 sm:w-60 dark:brightness-0 dark:invert" />
    </a>
    <span class="font-monospace text-xs text-muted-foreground">HERRAMIENTAS DE STAFF</span>
  </div>
</header>
