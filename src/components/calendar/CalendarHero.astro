---
import ArrowOutward from "@/assets/icons/arrow_outward.svg"

import { formatHeroDate, nameToSlug, type UpcomingCalendarEvent } from "@/lib/calendarUtils"

import Cathedral from "./Cathedral.svg"

interface Props {
  event: UpcomingCalendarEvent | undefined
}

const { event } = Astro.props

const terminalLine = event
  ? `próximo: ${nameToSlug(event.name)} · ${formatHeroDate(event.start_datetime)}`
  : "sin eventos próximos"
---

<section
  class="font-monospace mx-auto grid max-w-6xl gap-8 px-4 md:grid-cols-2 lg:items-center lg:gap-16 pb-4"
>
  <div class="flex min-w-0 flex-col gap-4 sm:gap-6">
    <p class="text-xs uppercase">[ 01 · señal ]</p>

    <h1 class="text-3xl md:text-4xl lg:text-6xl leading-tight font-bold text-white">
      La agenda tech de Sucre
    </h1>

    <div class="p-3 sm:p-4 flex items-center border border-white bg-black">
      <span class="text-red-500 font-bold mr-2">&gt;</span>
      <span class="min-w-0 flex-1 truncate text-sm text-white">
        {terminalLine}
      </span>
      <span class="bg-red-500 w-2 h-4 shrink-0 animate-pulse"></span>
    </div>

    <div class="flex flex-wrap items-center gap-4">
      <a
        href="#publicar"
        class="group bg-white hover:shadow-[4px_4px_0_0_var(--color-red-500)] inline-flex items-center gap-2 px-4 sm:px-6 py-3 md:py-4 text-sm font-bold text-black lg:text-base transition-all"
      >
        Sumar evento
        <ArrowOutward
          class="size-5 transition-transform ease-in-out group-hover:translate-1 group-hover:-translate-y-1"
        />
      </a>

      <a
        href="#agenda"
        class="border border-white px-4 md:px-6 py-3 md:py-4 text-sm text-white transition-colors hover:bg-red-500/50 lg:text-base"
      >
        Ver agenda
      </a>
    </div>
  </div>

  <Cathedral />
</section>
