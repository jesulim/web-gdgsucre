---
import { formatRangeLabel, type UpcomingCalendarEvent } from "@/lib/calendarUtils"

import NextEventCard from "./NextEventCard.astro"

interface Props {
  events: UpcomingCalendarEvent[]
}

const { events } = Astro.props

const rangeLabel = formatRangeLabel(events)
---

<section
  id="agenda"
  class="font-monospace mx-auto flex max-w-6xl flex-col gap-4 md:gap-6 px-4 py-8 md:py-12"
>
  <p class="text-xs uppercase">[ 02 · agenda ]</p>

  <div class="flex justify-between gap-4 items-center">
    <h2 class="text-2xl font-bold text-white md:text-5xl">
      <span>Próximos eventos</span>
    </h2>
    <span class="text-muted-foreground shrink-0">{rangeLabel}</span>
  </div>

  {
    events.length > 0 ? (
      <div class="flex flex-col gap-3">
        {events.map((event, index) => (
          <NextEventCard event={event} index={index} />
        ))}
      </div>
    ) : (
      <p class="text-muted-foreground border border-white/15 p-6 text-center text-sm">
        Todavía no hay eventos próximos. Publicá el tuyo acá abajo.
      </p>
    )
  }
</section>
