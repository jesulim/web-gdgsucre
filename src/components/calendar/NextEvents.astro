---
import { type UpcomingCalendarEvent } from "@/lib/calendarUtils"

import NextEventCard from "./NextEventCard.astro"

interface Props {
  events: UpcomingCalendarEvent[]
}

const { events } = Astro.props
---

<section
  id="agenda"
  class="font-monospace mx-auto flex max-w-6xl flex-col gap-4 md:gap-6 px-4 py-8 md:py-12"
>
  <p class="text-xs uppercase">[ 02 · agenda ]</p>

  <div class="flex justify-between gap-4 items-center">
    <h2 class="text-2xl font-bold text-white md:text-5xl">
      <span>Próximos eventos</span>
    </h2>
    <span class="text-muted-foreground shrink-0">{`${events.length}`.padStart(2, "0")}</span>
  </div>

  {
    events.length > 0 ? (
      <div class="flex flex-col gap-3">
        {events.map((event, index) => (
          <NextEventCard event={event} index={index} />
        ))}
      </div>
    ) : (
      <p class="bg-black text-muted-foreground border border-muted-foreground p-6 text-center text-sm">
        No hay eventos próximos.{" "}
        <a href="#publicar" class="text-white hover:underline">
          Suma el tuyo.
        </a>
      </p>
    )
  }
</section>
