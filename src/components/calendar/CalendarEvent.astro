---
import { BookingCalendar } from "@/components/calendar/BookingCalendar"
---

<section
  id="calendario"
  class="font-monospace mx-auto max-w-6xl px-4 pt-16 lg:pt-24"
>
  <div class="grid gap-8 lg:grid-cols-[2fr_3fr] lg:items-center lg:gap-16">
    <section class="flex flex-col gap-6 lg:sticky lg:top-28">
      <p class="text-green-lime text-xs uppercase">[ 04 · calendario ]</p>

      <span class="text-white text-4xl leading-none font-bold lowercase md:text-5xl">agosto</span>

      <div class="border border-white/30 bg-red-500/20 p-6 text-white">
        <div class="flex items-center gap-4">
          <span class="text-7xl leading-none font-bold md:text-8xl">18</span>
          <div class="flex flex-col text-sm leading-tight uppercase text-white/90">
            <span>Sábado</span>
            <span>Julio 2026</span>
          </div>
        </div>

        <div class="mt-6 rounded-lg border-l-4 border-red-500 bg-white/5 p-4">
          <h3 class="text-lg leading-tight font-bold text-white">DevFest Sucre 2026</h3>
          <p class="text-muted-foreground mt-1 text-sm">Inicio · 18:00</p>
          <a
            class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-white underline underline-offset-4 hover:text-white/80"
            href="#registro"
          >
            → registro
          </a>
        </div>
      </div>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-3">
        <li class="flex items-center gap-2 text-sm text-gray-400">
          <span class="size-3 shrink-0 bg-blue-500"></span>
          gdg
        </li>
        <li class="flex items-center gap-2 text-sm text-gray-400">
          <span class="size-3 shrink-0 bg-red-500"></span>
          flutter
        </li>
        <li class="flex items-center gap-2 text-sm text-gray-400">
          <span class="size-3 shrink-0 bg-yellow-600"></span>
          python
        </li>
        <li class="flex items-center gap-2 text-sm text-gray-400">
          <span class="size-3 shrink-0 bg-green-500"></span>
          ladies
        </li>
      </ul>
    </section>

    <BookingCalendar client:load />
  </div>
</section>
