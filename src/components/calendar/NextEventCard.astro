---
import ArrowOutward from "@/assets/icons/arrow_outward.svg"
import { formatEventDate, type UpcomingCalendarEvent } from "@/lib/calendarUtils"

interface Props {
  event: UpcomingCalendarEvent
  index: number
}

const { event, index } = Astro.props

const ACCENT_COLORS = ["bg-blue-500", "bg-red-500", "bg-yellow-600", "bg-green-500"]
const accent = ACCENT_COLORS[index % ACCENT_COLORS.length]

const isNext = index === 0
const { day, month, weekday, time } = formatEventDate(event.start_datetime)
const community = event.communities?.short_name ?? event.communities?.name
const position = String(index + 1).padStart(2, "0")
---

<article
  class:list={["font-monospace border", isNext ? "border-green-lime bg-black" : "border-white/15"]}
>
  <div class="md:hidden p-2 sm:p-4 flex gap-3 sm:gap-4">
    <div>
      <div
        class:list={[
          "size-10 sm:size-14 shrink-0 flex flex-col items-center justify-center text-black",
          accent,
        ]}
      >
        <span class="text-xl sm:text-2xl leading-none font-bold">{day}</span>
        <span class="text-xs leading-none font-bold uppercase">{month}</span>
      </div>
    </div>

    <div class="w-full flex flex-col gap-1">
      <div class="flex items-start gap-4">
        <h3 class="font-bold text-white -mr-1">
          {event.name}
        </h3>
        <span
          class:list={[
            "shrink-0 text-xs ml-auto mt-1.25 sm:text-sm sm:mt-0",
            isNext ? "text-green-lime" : "text-white/40",
          ]}
        >
          {time}
        </span>
      </div>

      <p class="text-muted-foreground truncate text-sm">// {community}</p>
      <p class="col-start-2 flex items-start gap-1 text-sm text-white/70">
        <svg
          class="mt-0.5 size-4 shrink-0"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"
          ></path>
          <circle cx="12" cy="10" r="3"></circle>
        </svg>
        <span class="flex gap-2">
          {event.location}
          {
            isNext && (
              <span class="hidden sm:block text-green-lime shrink-0 font-bold"> → próximo</span>
            )
          }
        </span>
      </p>
      {
        event.registration_link && (
          <a
            class="group flex gap-1 text-green-lime hover:underline"
            href={event.registration_link}
            target="_blank"
            rel="noopener noreferrer"
          >
            Regístrate
            <ArrowOutward class="fill-green-lime size-5 transition-transform ease-in-out translate-y-0.5 group-hover:translate-0.5 group-hover:-translate-y-0.5" />
          </a>
        )
      }
    </div>
  </div>

  <!-- Desktop: single row split into cells, as in the agenda table. -->
  <div class="hidden md:flex">
    <div class="w-fit flex items-center gap-3 p-4 shrink-0">
      <span class:list={["size-4 shrink-0", accent]}></span>
      <div>
        <p class="text-green-lime font-bold shrink-0 w-fit">{day} {month.toUpperCase()}</p>
        <p class="text-muted-foreground text-sm">{weekday}</p>
      </div>
    </div>

    <div
      class:list={[
        "w-1/2 flex flex-col justify-center border-l p-4",
        isNext ? "border-green-lime" : "border-white/15",
      ]}
    >
      <span class="text-xl font-bold text-white">
        {event.name}
      </span>
      <p class="text-muted-foreground truncate text-sm">// {community}</p>
    </div>

    {
      time && (
        <div
          class:list={[
            "flex items-center justify-center border-l p-4",
            isNext ? "border-green-lime" : "border-white/15",
          ]}
        >
          <span class="text-white">{time}</span>
        </div>
      )
    }

    <div
      class:list={[
        "w-5/12 items-center justify-between gap-3 border-l p-4",
        isNext ? "border-green-lime" : "border-white/15",
      ]}
    >
      <div class="flex flex-col gap-1">
        <span class="truncate text-muted-foreground flex gap-2">
          {event.location}
          {
            isNext ? (
              <span class="text-green-lime shrink-0 font-bold ml-auto">→ próximo</span>
            ) : (
              <span class="text-muted-foreground shrink-0 ml-auto">{position}</span>
            )
          }
        </span>
        {
          event.registration_link && (
            <a
              class="group flex gap-2 text-green-lime hover:underline"
              href={event.registration_link}
              target="_blank"
              rel="noopener noreferrer"
            >
              Regístrate
              <ArrowOutward class="fill-green-lime size-5 transition-transform ease-in-out translate-y-0.5 group-hover:translate-0.5 group-hover:-translate-y-0.5" />
            </a>
          )
        }
      </div>
    </div>
  </div>
</article>
