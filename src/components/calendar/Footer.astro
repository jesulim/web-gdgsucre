---
const navLinks = [
  { href: "#agenda", label: "Agenda" },
  { href: "#calendario", label: "Calendario" },
  { href: "#comunidades", label: "Comunidades" },
]

const socialLinks = [
  { href: "https://www.facebook.com/gdgsucre", label: "Facebook" },
  { href: "https://www.tiktok.com/@gdgsucre", label: "Tiktok" },
  { href: "https://www.instagram.com/gdg.sucre/", label: "Instagram" },
  { href: "https://www.youtube.com/@gdgsucre", label: "YouTube" },
  { href: "https://www.linkedin.com/company/gdgsucre/", label: "LinkedIn" },
  { href: "https://twitter.com/gdg_sucre", label: "Twitter" },
]
---

<footer class="w-full bg-black border-t border-red-500 font-monospace">
  <div class="max-w-7xl mx-auto flex flex-col gap-8 px-8 p-4 md:p-8">
    <div class="w-full flex flex-col md:flex-row gap-8 md:justify-between transition-colors">
      <div>
        <h3 class="text-4xl md:text-5xl mt-2 mb-4 font-medium">sucre.tech</h3>
        <p class="text-muted-foreground leading-relaxed text-sm md:text-base mb-2">
          Agenda de eventos tecnológicos en Sucre, Bolivia.
        </p>
        <p class="text-muted-foreground">
          Hecho por: <a
            class="text-white font-medium hover:underline"
            href="https://www.gdgsucre.com/"
            target="_blank"
            rel="noopener noreferrer"
          >
            GDG Sucre
          </a>
        </p>
        <p class="text-muted-foreground">
          Contáctanos: <a
            class="text-white font-medium hover:underline"
            href="mailto:gdgsucre@gmail.com"
          >
            gdgsucre@gmail.com
          </a>
        </p>
      </div>

      <div class="h-fit grid sm:grid-cols-2 gap-8 md:gap-6 text-sm md:text-base">
        <ul class="grid grid-cols-1 gap-y-4">
          <li>EXPLORAR</li>
          {
            navLinks.map(link => (
              <li>
                <a
                  class="text-muted-foreground hover:text-white hover:underline transition-colors"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>

        <ul class="w-fit grid grid-cols-2 gap-y-4 gap-x-8">
          <li class="col-span-2">REDES GDG SUCRE</li>
          {
            socialLinks.map(link => (
              <li>
                <a
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-muted-foreground hover:text-white hover:underline"
                  href={link.href}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <hr class="border-t border-muted-foreground" />

    <span class="text-muted-foreground text-xs md:text-sm">
      &copy; {new Date().getFullYear()} Google Developer Group Sucre <span class="hidden sm:inline">
        · proyecto comunitario · sin fines de lucro
      </span>
    </span>
    <div class="bg-red-500 w-48 h-1"></div>
  </div>
</footer>
