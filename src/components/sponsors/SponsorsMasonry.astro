---
import ScrambledText from "@/components/landing/ScrambledText.astro"
import SponsorCard from "@/components/sponsors/SponsorCard.astro"
import { SPONSOR_CATEGORY_META, SPONSORS, type SponsorCategory } from "@/lib/data/sponsors"

const categories = Object.entries(SPONSOR_CATEGORY_META) as [
  SponsorCategory,
  (typeof SPONSOR_CATEGORY_META)[SponsorCategory],
][]

const categoryCounts = SPONSORS.reduce<Record<string, number>>((acc, sponsor) => {
  acc[sponsor.category] = (acc[sponsor.category] || 0) + 1
  return acc
}, {})
---

<section
  id="sponsors-wall"
  class="border-t border-black/10 dark:border-white/10 bg-neutral-50/70 dark:bg-[#1b1c21]/60 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-8">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-2 text-xs sm:text-sm">
        <ScrambledText text="{ QUIENES CONFÍAN EN NOSOTROS }" />
        <span class="w-3 h-1 bg-yellow-600 shrink-0" aria-hidden="true"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Organizaciones que impulsan a GDG Sucre
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        {SPONSORS.length} empresas, instituciones educativas, organizaciones civiles y aliados locales
        que han hecho posible el crecimiento de nuestra comunidad tecnológica.
      </p>
    </div>

    <div class="flex flex-col gap-3" data-sponsors-filter-root>
      <ul
        role="list"
        class="flex flex-wrap gap-2.5"
        aria-label="Filtrar organizaciones aliadas por categoría"
      >
        <li>
          <button
            type="button"
            data-filter-all
            aria-pressed="true"
            class="sponsor-filter-btn inline-flex items-center gap-2 rounded-full border min-h-9 px-3.5 py-1.5 text-xs font-monospace transition-colors cursor-pointer touch-manipulation bg-black text-white border-black dark:bg-white dark:text-black dark:border-white"
          >
            <svg
              data-filter-check
              aria-hidden="true"
              viewBox="0 0 20 20"
              class="size-3.5 fill-current shrink-0"
            >
              <path
                fill-rule="evenodd"
                d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                clip-rule="evenodd"></path>
            </svg>
            <span>Todas</span>
            <span class="opacity-80 tabular-nums">({SPONSORS.length})</span>
          </button>
        </li>

        {
          categories.map(([category, meta]) => (
            <li>
              <button
                type="button"
                data-filter-category={category}
                data-active-class={meta.filterActiveClass}
                aria-pressed="false"
                class="sponsor-filter-btn inline-flex items-center gap-2 rounded-full border min-h-9 px-3.5 py-1.5 text-xs font-monospace transition-colors cursor-pointer touch-manipulation border-black/15 dark:border-white/15 bg-white dark:bg-[#18191e] text-black dark:text-white hover:border-black/40 dark:hover:border-white/40"
              >
                <span
                  class:list={["size-2 rounded-full shrink-0", meta.dotClass]}
                  aria-hidden="true"
                />
                <span>{category}</span>
                <span class="text-black/70 dark:text-io-text-muted tabular-nums">
                  ({categoryCounts[category] || 0})
                </span>
                <svg
                  data-filter-check
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  class="hidden size-3.5 fill-current shrink-0"
                >
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </button>
            </li>
          ))
        }
      </ul>

      <p
        data-filter-summary
        class="font-monospace text-xs text-black/70 dark:text-io-text-muted"
      >
        Mostrando {SPONSORS.length} de {SPONSORS.length} organizaciones
      </p>
      <span data-filter-live class="sr-only" role="status" aria-live="polite"></span>
    </div>

    <div class="sponsors-masonry py-2 px-1 -my-1 -mx-1">
      {SPONSORS.map(sponsor => <SponsorCard sponsor={sponsor} />)}
    </div>
  </div>
</section>

<style>
  .sponsors-masonry {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .sponsors-masonry {
      columns: 2;
    }
  }

  @media (min-width: 768px) {
    .sponsors-masonry {
      columns: 3;
    }
  }

  @media (min-width: 1024px) {
    .sponsors-masonry {
      columns: 4;
    }
  }

  .sponsors-masonry > :global(.sponsors-masonry-item) {
    display: inline-flex;
    width: 100%;
    break-inside: avoid;
    margin-block-end: 1rem;
  }

  .sponsors-masonry > :global(.sponsors-masonry-item[hidden]) {
    display: none;
  }

  .sponsor-filter-btn[aria-pressed="true"] {
    outline: 1px solid currentColor;
    outline-offset: -1px;
  }

  @supports (grid-template-rows: masonry) {
    .sponsors-masonry {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      grid-template-rows: masonry;
      gap: 1rem;
      columns: unset;
    }

    .sponsors-masonry > :global(.sponsors-masonry-item) {
      display: flex;
      margin-block-end: 0;
    }

    .sponsors-masonry > :global(.sponsors-masonry-item[hidden]) {
      display: none;
    }
  }
</style>

<script>
  const wallSection = document.getElementById("sponsors-wall")
  const allBtn = wallSection?.querySelector<HTMLButtonElement>("[data-filter-all]")
  const categoryBtns = Array.from(
    wallSection?.querySelectorAll<HTMLButtonElement>("[data-filter-category]") ?? []
  )
  const cards = Array.from(wallSection?.querySelectorAll<HTMLElement>("[data-sponsor-card]") ?? [])
  const summaryEl = wallSection?.querySelector<HTMLElement>("[data-filter-summary]")
  const liveEl = wallSection?.querySelector<HTMLElement>("[data-filter-live]")

  if (allBtn && categoryBtns.length > 0 && cards.length > 0) {
    const ALL_ACTIVE_CLASSES = [
      "bg-black",
      "text-white",
      "border-black",
      "dark:bg-white",
      "dark:text-black",
      "dark:border-white",
    ]
    const INACTIVE_CLASSES = [
      "border-black/15",
      "dark:border-white/15",
      "bg-white",
      "dark:bg-[#18191e]",
      "text-black",
      "dark:text-white",
      "hover:border-black/40",
      "dark:hover:border-white/40",
    ]

    const selectedCategories = new Set<string>()
    const totalCount = cards.length

    const setClasses = (el: HTMLElement, classes: string[], present: boolean) => {
      for (const cls of classes) {
        if (cls) el.classList.toggle(cls, present)
      }
    }

    const applyFilter = (announce: boolean) => {
      const showAll = selectedCategories.size === 0

      allBtn.setAttribute("aria-pressed", String(showAll))
      setClasses(allBtn, ALL_ACTIVE_CLASSES, showAll)
      setClasses(allBtn, INACTIVE_CLASSES, !showAll)
      allBtn.querySelector("[data-filter-check]")?.classList.toggle("hidden", !showAll)

      for (const btn of categoryBtns) {
        const category = btn.dataset.filterCategory ?? ""
        const isActive = selectedCategories.has(category)
        const activeClasses = (btn.dataset.activeClass ?? "").split(/\s+/).filter(Boolean)

        btn.setAttribute("aria-pressed", String(isActive))
        setClasses(btn, activeClasses, isActive)
        setClasses(btn, INACTIVE_CLASSES, !isActive)
        btn.querySelector("[data-filter-check]")?.classList.toggle("hidden", !isActive)
      }

      let visibleCount = 0
      for (const card of cards) {
        const category = card.dataset.category ?? ""
        const isVisible = showAll || selectedCategories.has(category)
        card.hidden = !isVisible
        if (isVisible) visibleCount++
      }

      const message = showAll
        ? `Mostrando ${visibleCount} de ${totalCount} organizaciones`
        : `Mostrando ${visibleCount} de ${totalCount} organizaciones (${selectedCategories.size} ${selectedCategories.size === 1 ? "categoría seleccionada" : "categorías seleccionadas"})`

      if (summaryEl) {
        summaryEl.textContent = message
      }
      if (announce && liveEl) {
        liveEl.textContent = message
      }
    }

    allBtn.addEventListener("click", () => {
      selectedCategories.clear()
      applyFilter(true)
    })

    for (const btn of categoryBtns) {
      btn.addEventListener("click", () => {
        const category = btn.dataset.filterCategory
        if (!category) return

        if (selectedCategories.has(category)) {
          selectedCategories.delete(category)
        } else {
          selectedCategories.add(category)
        }

        applyFilter(true)
      })
    }
  }
</script>
