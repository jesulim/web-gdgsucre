---
import { Image } from "astro:assets"
import ArrowOutward from "@/assets/icons/arrow_outward.svg"
import ScrambledText from "@/components/landing/ScrambledText.astro"
import SponsorLogo from "@/components/sponsors/SponsorLogo.astro"
import { SPONSOR_CATEGORY_META, SPONSORS, type SponsorCategory } from "@/lib/data/sponsors"

const categories = Object.entries(SPONSOR_CATEGORY_META) as [
  SponsorCategory,
  (typeof SPONSOR_CATEGORY_META)[SponsorCategory],
][]

const categoryCounts = SPONSORS.reduce<Record<string, number>>((acc, sponsor) => {
  acc[sponsor.category] = (acc[sponsor.category] || 0) + 1
  return acc
}, {})
---

<section
  id="sponsors-wall"
  class="border-t border-black/10 dark:border-white/10 bg-neutral-50/70 dark:bg-[#1b1c21]/60 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-8">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-2 text-xs sm:text-sm">
        <ScrambledText text="{ QUIENES CONFÍAN EN NOSOTROS }" />
        <span class="w-3 h-1 bg-yellow-600 shrink-0" aria-hidden="true"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Organizaciones que impulsan a GDG Sucre
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        {SPONSORS.length} empresas, instituciones educativas, organizaciones civiles y aliados locales
        que han hecho posible el crecimiento de nuestra comunidad tecnológica.
      </p>
    </div>

    <ul role="list" class="flex flex-wrap gap-2.5" aria-label="Categorías de organizaciones aliadas">
      {
        categories.map(([category, meta]) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-black/10 dark:border-white/15 bg-white dark:bg-[#18191e] px-3.5 py-1.5 text-xs font-monospace">
            <span class:list={["size-2 rounded-full shrink-0", meta.dotClass]} aria-hidden="true" />
            <span>{category}</span>
            <span class="text-black/70 dark:text-io-text-muted tabular-nums">
              ({categoryCounts[category] || 0})
            </span>
          </li>
        ))
      }
    </ul>

    <div class="sponsors-masonry py-2 px-1 -my-1 -mx-1">
      {
        SPONSORS.map(sponsor => {
          const meta = SPONSOR_CATEGORY_META[sponsor.category]
          const isFeatured = sponsor.masonrySize === "featured"
          const isCompact = sponsor.masonrySize === "compact"

          const cardPaddingClass = isFeatured
            ? "p-5 sm:p-6 gap-4"
            : isCompact
              ? "p-3.5 sm:p-4 gap-3"
              : "p-4 sm:p-5 gap-3.5"

          const stageClass = isFeatured
            ? "min-h-40 sm:min-h-44 p-5"
            : isCompact
              ? "min-h-24 p-3"
              : "min-h-32 p-4"

          const imgClass = isFeatured
            ? "max-h-24 sm:max-h-28 w-auto max-w-full"
            : isCompact
              ? "max-h-14 w-auto max-w-full"
              : "max-h-20 w-auto max-w-full"

          return (
            <article
              class:list={[
                "sponsors-masonry-item group relative flex flex-col justify-between rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#18191e] overflow-clip transition-all duration-200 hover:-translate-y-1 hover:shadow-lg dark:hover:border-white/25",
                cardPaddingClass,
              ]}
            >
              {isFeatured && (
                <span
                  class:list={["absolute inset-x-0 top-0 h-1", meta.accentBarClass]}
                  aria-hidden="true"
                />
              )}

              <SponsorLogo
                sponsor={sponsor}
                decorative={true}
                stageClass={`${stageClass} group-hover:scale-[1.01]`}
                imgClass={imgClass}
              />

              <div class="flex flex-col gap-2">
                <div class="flex items-start justify-between gap-2">
                  <h3 class:list={["font-semibold leading-snug text-balance", isFeatured ? "text-lg" : "text-base"]}>
                    {sponsor.url ? (
                      <a
                        href={sponsor.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="sponsor-card-link after:absolute after:inset-0 focus-visible:outline-none hover:underline"
                      >
                        {sponsor.name}
                        <span class="sr-only"> (sitio externo, abre en una nueva pestaña)</span>
                      </a>
                    ) : (
                      sponsor.name
                    )}
                  </h3>

                  {sponsor.url && (
                    <ArrowOutward
                      aria-hidden="true"
                      class="size-4 shrink-0 mt-1 fill-current text-black/65 dark:text-io-text-muted group-hover:text-blue-700 dark:group-hover:text-io-accent group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all"
                    />
                  )}
                </div>

                {!isCompact && (
                  <p class="text-xs sm:text-sm leading-relaxed text-black/75 dark:text-io-text-secondary text-pretty">
                    {sponsor.note}
                  </p>
                )}

                <div class="flex items-center justify-between gap-2 pt-1">
                  <span
                    class:list={[
                      "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 font-monospace text-xs leading-tight",
                      meta.badgeClass,
                    ]}
                  >
                    <span
                      class:list={["size-1.5 rounded-full shrink-0", meta.dotClass]}
                      aria-hidden="true"
                    />
                    <span>{sponsor.category}</span>
                  </span>

                  {sponsor.emblem && (
                    <span class="inline-flex items-center justify-center rounded-lg bg-blue-500/8 dark:bg-blue-500/15 p-1.5 shrink-0">
                      <Image
                        src={sponsor.emblem}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="size-5 object-contain"
                      />
                    </span>
                  )}
                </div>
              </div>
            </article>
          )
        })
      }
    </div>
  </div>
</section>

<style>
  .sponsors-masonry {
    columns: 1;
    column-gap: 1rem;
  }

  @media (min-width: 640px) {
    .sponsors-masonry {
      columns: 2;
    }
  }

  @media (min-width: 768px) {
    .sponsors-masonry {
      columns: 3;
    }
  }

  @media (min-width: 1024px) {
    .sponsors-masonry {
      columns: 4;
    }
  }

  .sponsors-masonry-item {
    display: inline-flex;
    width: 100%;
    break-inside: avoid;
    margin-block-end: 1rem;
  }

  .sponsors-masonry-item:has(.sponsor-card-link:focus-visible) {
    outline: 2px solid var(--color-blue-500);
    outline-offset: 2px;
  }

  @supports (grid-template-rows: masonry) {
    .sponsors-masonry {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      grid-template-rows: masonry;
      gap: 1rem;
      columns: unset;
    }

    .sponsors-masonry-item {
      display: flex;
      margin-block-end: 0;
    }
  }
</style>
