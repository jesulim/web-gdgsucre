---
import ScrambledText from "@/components/landing/ScrambledText.astro"
import {
  ANNUAL_MILESTONES,
  AUDIENCE_SEGMENTS,
  BRAND_DELIVERABLES,
  CONTRIBUTION_MODALITIES,
  REACH_METRICS,
  STRATEGIC_PILLARS,
  TECH_TOPICS,
} from "@/lib/data/sponsors"
---

<section
  id="impacto"
  class="border-t border-black/10 dark:border-white/10 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-3 text-xs sm:text-sm">
        <ScrambledText text="{ COMUNIDAD ACTIVA }" />
        <span class="flex items-center gap-1 shrink-0" aria-hidden="true">
          <span class="size-2 rounded-full bg-blue-500"></span>
          <span class="size-2 rounded-full bg-red-500"></span>
          <span class="size-2 rounded-full bg-yellow-600"></span>
          <span class="size-2 rounded-full bg-green-500"></span>
        </span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Un año entero de innovación y formación tecnológica
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        GDG Sucre impulsa una agenda continua de talleres, charlas y conferencias abiertas durante
        todo el año, conectando estudiantes, profesionales y empresas del ecosistema tech local.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        ANNUAL_MILESTONES.map(item => (
          <article class="group relative flex flex-col justify-between gap-4 rounded-2xl border border-black/10 dark:border-white/10 bg-neutral-50 dark:bg-[#1b1c21] p-6 overflow-clip transition-transform duration-200 hover:-translate-y-0.5">
            <span
              class:list={["absolute inset-x-0 top-0 h-1", item.accentColorClass]}
              aria-hidden="true"
            />
            <div class="flex flex-col gap-2 pt-1">
              <span class="font-monospace text-xs uppercase tracking-wider text-black/70 dark:text-io-text-muted">
                {item.metric}
              </span>
              <h3 class="text-xl font-semibold text-balance">{item.title}</h3>
            </div>
            <p class="text-sm leading-relaxed text-black/75 dark:text-io-text-secondary text-pretty">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#18191e] px-5 py-4"
    >
      <span
        class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted shrink-0"
      >
        Ejes técnicos:
      </span>
      <ul role="list" class="flex flex-wrap gap-2">
        {
          TECH_TOPICS.map(topic => (
            <li class="rounded-full border border-black/15 dark:border-white/15 bg-neutral-100 dark:bg-white/5 px-3 py-1 font-monospace text-xs">
              {topic}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<section
  id="por-que-sumarte"
  class="border-t border-black/10 dark:border-white/10 bg-neutral-50/70 dark:bg-[#1b1c21]/60 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-2 text-xs sm:text-sm">
        <ScrambledText text="{ POR QUÉ SUMARTE }" />
        <span class="w-3 h-1 bg-blue-500 shrink-0" aria-hidden="true"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Visibilidad estratégica con impacto real en el talento regional
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        Auspiciar a GDG Sucre posiciona tu organización ante una audiencia técnica activa y
        financia espacios gratuitos para que más personas aprendan y construyan tecnología.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {
        STRATEGIC_PILLARS.map(pillar => (
          <article
            class:list={[
              "flex flex-col gap-3 rounded-2xl border border-black/10 dark:border-white/10 border-t-4 bg-white dark:bg-[#18191e] p-6 sm:p-7",
              pillar.borderAccentClass,
            ]}
          >
            <span class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted">
              {pillar.tag}
            </span>
            <h3 class="text-xl font-semibold text-balance">{pillar.title}</h3>
            <p class="text-sm sm:text-base leading-relaxed text-black/75 dark:text-io-text-secondary text-pretty">
              {pillar.description}
            </p>
          </article>
        ))
      }
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div
        class="lg:col-span-6 flex flex-col justify-between gap-6 rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#18191e] p-6 sm:p-8"
      >
        <div class="flex flex-col gap-1">
          <span
            class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted"
          >
            Alcance comprobado
          </span>
          <h3 class="text-2xl font-semibold text-balance">Presencia digital y presencial</h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
          {
            REACH_METRICS.map(metric => (
              <div class="flex flex-col gap-1 rounded-xl border border-black/10 dark:border-white/10 bg-neutral-50 dark:bg-[#202127] p-4">
                <span class:list={["text-3xl font-bold tabular-nums", metric.accentClass]}>
                  {metric.value}
                </span>
                <span class="text-sm text-black/75 dark:text-io-text-secondary text-pretty">
                  {metric.label}
                </span>
              </div>
            ))
          }
        </div>

        <p
          class="font-monospace text-xs uppercase tracking-wider text-black/70 dark:text-io-text-muted border-t border-black/10 dark:border-white/10 pt-4"
        >
          +28 organizadores voluntarios activos impulsando la comunidad en Sucre
        </p>
      </div>

      <div
        class="lg:col-span-6 flex flex-col justify-between gap-6 rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#18191e] p-6 sm:p-8"
      >
        <div class="flex flex-col gap-1">
          <span
            class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted"
          >
            Demografía de asistentes
          </span>
          <h3 class="text-2xl font-semibold text-balance">¿A quién llega tu marca?</h3>
          <p class="text-sm text-black/75 dark:text-io-text-secondary text-pretty">
            Una combinación sólida de futuros profesionales tech, desarrolladores activos y
            emprendedores de la región.
          </p>
        </div>

        <ul role="list" class="flex flex-col gap-4">
          {
            AUDIENCE_SEGMENTS.map(segment => (
              <li class="flex flex-col gap-1.5">
                <div class="flex items-center justify-between gap-2 text-sm font-medium">
                  <span class="flex items-center gap-2">
                    <span
                      class:list={["size-2.5 rounded-full shrink-0", segment.dotClass]}
                      aria-hidden="true"
                    />
                    <span>{segment.label}</span>
                  </span>
                  <span class="font-monospace font-semibold tabular-nums">
                    {segment.percentage}%
                  </span>
                </div>
                <div
                  class="h-3 w-full rounded-full border border-black/10 dark:border-white/15 bg-black/8 dark:bg-white/10 overflow-clip forced-colors:border-[CanvasText]"
                  aria-hidden="true"
                >
                  <div
                    class:list={["h-full rounded-full forced-colors:bg-[Highlight]", segment.barColorClass]}
                    style={`width: ${segment.percentage}%`}
                  />
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section
  id="como-aportar"
  class="border-t border-black/10 dark:border-white/10 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-2 text-xs sm:text-sm">
        <ScrambledText text="{ CÓMO APORTAR }" />
        <span class="w-3 h-1 bg-green-500 shrink-0" aria-hidden="true"></span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Alianzas flexibles a la medida de tu organización
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        No trabajamos con paquetes cerrados ni esquemas rígidos: armamos la propuesta junto a tu
        equipo, según lo que quieran lograr y aportar durante el año o en eventos específicos.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {
        CONTRIBUTION_MODALITIES.map(modality => (
          <article
            class:list={[
              "flex flex-col gap-4 rounded-2xl border border-black/10 dark:border-white/10 border-t-4 bg-neutral-50 dark:bg-[#1b1c21] p-6",
              modality.topBorderClass,
            ]}
          >
            <div class="flex items-center justify-between gap-2">
              <span
                class:list={[
                  "inline-flex items-center rounded-full px-3 py-1 font-monospace text-xs font-medium",
                  modality.pillClass,
                ]}
              >
                Modalidad {modality.number}
              </span>
            </div>
            <h3 class="text-xl font-semibold text-balance">{modality.title}</h3>
            <p class="text-sm leading-relaxed text-black/75 dark:text-io-text-secondary text-pretty">
              {modality.description}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="rounded-2xl border border-black/10 dark:border-white/10 bg-neutral-50 dark:bg-[#1b1c21] p-6 sm:p-8 flex flex-col gap-6"
    >
      <div class="flex flex-col gap-1">
        <span
          class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted"
        >
          Retorno de marca
        </span>
        <h3 class="text-2xl font-semibold text-balance">
          ¿Qué recibe tu empresa o institución al sumarse?
        </h3>
      </div>

      <ul role="list" class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3.5">
        {
          BRAND_DELIVERABLES.map(deliverable => (
            <li class="flex items-start gap-3 text-sm sm:text-base text-black/85 dark:text-io-text">
              <span
                class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-green-500/15 text-green-700 dark:text-io-green-light"
                aria-hidden="true"
              >
                <svg viewBox="0 0 20 20" class="size-3.5 fill-current">
                  <path
                    fill-rule="evenodd"
                    d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z"
                    clip-rule="evenodd"
                  />
                </svg>
              </span>
              <span class="text-pretty">{deliverable}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
