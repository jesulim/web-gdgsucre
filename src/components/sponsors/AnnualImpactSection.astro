---
import ScrambledText from "@/components/landing/ScrambledText.astro"
import { ANNUAL_MILESTONES, TECH_TOPICS } from "@/lib/data/sponsors"
---

<section
  id="impacto"
  class="border-t border-black/10 dark:border-white/10 py-16 sm:py-20 px-4 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-6xl flex flex-col gap-10">
    <div class="flex flex-col gap-3 max-w-3xl">
      <div class="flex items-center gap-3 text-xs sm:text-sm">
        <ScrambledText text="{ COMUNIDAD ACTIVA }" />
        <span class="flex items-center gap-1 shrink-0" aria-hidden="true">
          <span class="size-2 rounded-full bg-blue-500"></span>
          <span class="size-2 rounded-full bg-red-500"></span>
          <span class="size-2 rounded-full bg-yellow-600"></span>
          <span class="size-2 rounded-full bg-green-500"></span>
        </span>
      </div>

      <h2 class="text-3xl sm:text-4xl font-semibold tracking-tight text-balance">
        Un año entero de innovación y formación tecnológica
      </h2>

      <p class="text-base sm:text-lg text-black/75 dark:text-io-text-secondary text-pretty">
        GDG Sucre impulsa una agenda continua de talleres, charlas y conferencias abiertas durante
        todo el año, conectando estudiantes, profesionales y empresas del ecosistema tech local.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {
        ANNUAL_MILESTONES.map(item => (
          <article class="group relative flex flex-col justify-between gap-4 rounded-2xl border border-black/10 dark:border-white/10 bg-neutral-50 dark:bg-[#1b1c21] p-6 overflow-clip transition-transform duration-200 hover:-translate-y-0.5">
            <span
              class:list={["absolute inset-x-0 top-0 h-1", item.accentColorClass]}
              aria-hidden="true"
            />
            <div class="flex flex-col gap-2 pt-1">
              <span class="font-monospace text-xs uppercase tracking-wider text-black/70 dark:text-io-text-muted">
                {item.metric}
              </span>
              <h3 class="text-xl font-semibold text-balance">{item.title}</h3>
            </div>
            <p class="text-sm leading-relaxed text-black/75 dark:text-io-text-secondary text-pretty">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>

    <div
      class="flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 rounded-2xl border border-black/10 dark:border-white/10 bg-white dark:bg-[#18191e] px-5 py-4"
    >
      <span
        class="font-monospace text-xs uppercase tracking-widest text-black/70 dark:text-io-text-muted shrink-0"
      >
        Ejes técnicos:
      </span>
      <ul role="list" class="flex flex-wrap gap-2">
        {
          TECH_TOPICS.map(topic => (
            <li class="rounded-full border border-black/15 dark:border-white/15 bg-neutral-100 dark:bg-white/5 px-3 py-1 font-monospace text-xs">
              {topic}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
