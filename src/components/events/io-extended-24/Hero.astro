---
import CalendarLogo from "./icons/Calendar.astro"
import IOExtendedLogo from "./icons/IOExtended.astro"
import LocationMarker from "./icons/LocationMarker.astro"
---

<section id="hero" class="pt-32 sm:pt-40 md:pt-44 pb-14 px-4 flex flex-col items-center">
  <!-- Logotipo principal en gran formato -->
  <div class="flex justify-center w-full">
    <IOExtendedLogo class="w-72 sm:w-[480px] md:w-[620px] lg:w-[720px] h-auto text-black dark:text-white" />
  </div>

  <!-- Título Sucre 2024 con tamaño ampliado -->
  <h1 class="text-center font-medium text-3xl sm:text-5xl md:text-6xl mt-4 mb-8 text-neutral-900 dark:text-white tracking-tight">
    Sucre 2024
  </h1>

  <!-- Botón Regístrate estético con gradiente original -->
  <div class="flex justify-center my-2">
    <span
      class="inline-block py-2.5 px-8 sm:py-3.5 sm:px-12 rounded-full text-xl sm:text-2xl md:text-3xl text-center text-white font-medium bg-gradient-to-r from-[#EA4335] via-[#F46831] via-75% to-[#FFCB32] shadow-sm select-none cursor-default"
    >
      Regístrate
    </span>
  </div>

  <!-- Fecha y Ubicación en dos columnas limpias sin tarjeta contenedora -->
  <div class="mt-8 mb-6 flex flex-col sm:flex-row items-center justify-center gap-6 sm:gap-12 md:gap-16 text-neutral-900 dark:text-white">
    <div class="flex items-start gap-3">
      <div class="mt-1 text-black dark:text-white">
        <CalendarLogo class="w-6 h-6" />
      </div>
      <div class="text-left leading-snug">
        <span class="block text-lg sm:text-xl font-medium">Sábado 13 de julio</span>
        <span class="block text-sm sm:text-base text-neutral-600 dark:text-neutral-400">08:30 hrs.</span>
      </div>
    </div>

    <div class="flex items-start gap-3">
      <div class="mt-1 text-black dark:text-white">
        <LocationMarker class="w-6 h-6" />
      </div>
      <div class="text-left leading-snug">
        <span class="block text-lg sm:text-xl font-medium">CAINCO Chuquisaca</span>
        <span class="block text-sm sm:text-base text-neutral-600 dark:text-neutral-400">Calle España #64</span>
      </div>
    </div>
  </div>

  <!-- Leyenda de Evento Concluido en azul Google -->
  <div class="mt-6 text-center space-y-1">
    <div class="text-blue-500 font-bold text-2xl sm:text-3xl md:text-4xl">
      ¡Evento Concluido!
    </div>
    <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400">
      Google I/O Extended Sucre 2024
    </p>
  </div>
</section>
