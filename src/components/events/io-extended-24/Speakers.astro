---
import type { ImageMetadata } from "astro"
import speakersData from "@/data/io-extended-24/speakers.json"
import SectionTitle from "./SectionTitle.astro"
import SpeakerCard from "./SpeakerCard.astro"

const speakerImages = import.meta.glob<{ default: ImageMetadata }>("/src/assets/speakers/*.webp", {
  eager: true,
})
---

<SectionTitle id="speakers" title="Speakers" />
<div class="max-w-screen-lg mx-auto grid grid-cols-2 md:grid-cols-3 gap-8 px-4 my-8">
  {
    speakersData.map((speaker, index) => {
      const imageModule = speakerImages[`/src/assets/speakers/${speaker.fileName}`]
      return (
        <SpeakerCard
          id={index}
          name={speaker.name}
          location={speaker.location}
          image={imageModule?.default}
        />
      )
    })
  }
</div>
