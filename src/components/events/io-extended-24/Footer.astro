---
import Bicycle from "@/assets/events/io-extended-24/io24-bicycle.svg"
import BicycleDark from "@/assets/events/io-extended-24/io24-bicycle-dark.svg"
import GDGSucreLogo from "./icons/GDGSucreLogo.astro"
import SocialIcons from "./SocialIcons.astro"
---

<footer class="relative pt-6 md:pt-12 bg-neutral-100 dark:bg-black border-t-2 border-black dark:border-white transition-colors duration-200">
  <div class="w-full overflow-hidden leading-none">
    <Bicycle class="w-full h-auto object-cover dark:hidden" />
    <BicycleDark class="w-full h-auto object-cover hidden dark:block" />
  </div>

  <div class="bg-white dark:bg-neutral-900 border-t border-neutral-200 dark:border-neutral-800">
    <div class="mx-auto max-w-screen-xl px-4 py-8 sm:py-12">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 text-sm sm:text-base font-medium">
        <div class="flex items-center">
          <GDGSucreLogo />
        </div>

        <div class="flex flex-wrap items-center justify-center gap-6">
          <a
            href="/eventos"
            class="text-neutral-700 dark:text-neutral-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
          >
            Eventos Pasados
          </a>

          <a
            href="https://developers.google.com/community-guidelines"
            target="_blank"
            rel="noopener noreferrer"
            class="text-neutral-700 dark:text-neutral-300 hover:text-blue-500 dark:hover:text-blue-400 transition-colors"
          >
            Lineamientos de la comunidad
          </a>
        </div>

        <SocialIcons />
      </div>

      <div class="mt-8 pt-6 border-t border-neutral-200 dark:border-neutral-800 text-center text-xs text-neutral-500">
        © 2024 Google Developer Group Sucre. Todos los derechos reservados.
      </div>
    </div>
  </div>
</footer>
