---
import scheduleData from "@/data/io-extended-24/schedule.json"
import ScheduleCard from "./ScheduleCard.astro"
import SectionTitle from "./SectionTitle.astro"
---

<div class="bg-[#EEEEEE] dark:bg-[#202124] transition-colors duration-200">
  <SectionTitle id="agenda" title="Agenda" />
  <div
    class="schedule flex flex-row overflow-scroll snap-x snap-mandatory text-[#202124] dark:text-white md:justify-center md:overflow-hidden"
  >
    <div class="snap-start pl-4 py-2">
      <h3 class="font-semibold text-2xl">Mañana</h3>
      {scheduleData.day.map(talk => <ScheduleCard {...talk} type="talk" />)}
    </div>
    <!-- vertical divisor -->
    <div class="border-l-2 border-gray-600 mt-12 mx-3 md:mx-4"></div>

    <div class="snap-start pr-4 py-2">
      <h3 class="font-semibold text-2xl">Tarde</h3>
      {scheduleData.afternoon.map(workshop => <ScheduleCard {...workshop} type="workshop" />)}
    </div>
  </div>
</div>

<style>
  /* Hide scrollbar for Chrome, Safari and Opera */
  .schedule::-webkit-scrollbar {
    display: none;
  }

  /* Hide scrollbar for IE, Edge and Firefox */
  .schedule {
    -ms-overflow-style: none; /* IE and Edge */
    scrollbar-width: none; /* Firefox */
  }
</style>
