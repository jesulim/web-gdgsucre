---
import scheduleData from "@/data/io-extended-24/schedule.json"
import ScheduleCard from "./ScheduleCard.astro"
import SectionTitle from "./SectionTitle.astro"
---

<section id="agenda" class="my-16 md:my-24 py-12 md:py-16 bg-[#EEEEEE] dark:bg-[#202124] transition-colors duration-200 scroll-mt-20">
  <SectionTitle title="Agenda" />
  <div class="max-w-screen-lg mx-auto px-4 mt-6">
    <div
      class="flex flex-col md:flex-row md:justify-center gap-8 md:gap-4 lg:gap-8 text-[#202124] dark:text-white"
    >
      <div class="w-full md:w-1/2 lg:w-[31rem]">
        <h3 class="font-semibold text-2xl mb-2">Mañana</h3>
        {scheduleData.day.map(talk => <ScheduleCard {...talk} type="talk" />)}
      </div>

      <!-- Divisor vertical en desktop / horizontal sutil en mobile -->
      <div class="hidden md:block border-l-2 border-gray-400 dark:border-gray-600 mt-12 mx-2 lg:mx-4 self-stretch"></div>
      <div class="block md:hidden border-t-2 border-gray-300 dark:border-gray-700 my-2"></div>

      <div class="w-full md:w-1/2 lg:w-[31rem]">
        <h3 class="font-semibold text-2xl mb-2">Tarde</h3>
        {scheduleData.afternoon.map(workshop => <ScheduleCard {...workshop} type="workshop" />)}
      </div>
    </div>
  </div>
</section>
