---
import IOExtended from "./icons/IOExtended.astro"
import IOExtendedShort from "./icons/IOExtended-short.astro"
import { ThemeToggle } from "./ThemeToggle"

const navLinks = [
  { name: "Speakers", href: "#speakers", hoverClass: "hover:text-[#4285F4]" },
  { name: "Agenda", href: "#agenda", hoverClass: "hover:text-[#F46831]" },
  { name: "Equipo", href: "#organizadores", hoverClass: "hover:text-[#9F6CD4]" },
  { name: "Eventos Pasados", href: "/eventos", hoverClass: "hover:text-[#EA4335]" },
]
---

<nav
  class="fixed w-full z-20 top-0 left-0 border-b-2 border-[#202124] bg-[#EEEEEE] dark:bg-[#202124] dark:text-white dark:border-white transition-colors duration-200"
>
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="#hero" aria-label="Volver al inicio" class="flex items-center">
      <div class="block md:hidden">
        <IOExtendedShort />
      </div>
      <div class="hidden md:block">
        <IOExtended class="text-[#202124] dark:text-white" />
      </div>
    </a>

    <!-- Mobile toggle and hamburger -->
    <div class="flex md:order-2 md:hidden items-center gap-1">
      <ThemeToggle client:load />

      <button
        id="navbar-toggle-btn"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-[#202124] dark:text-white rounded-lg md:hidden focus:outline-none focus:ring-2 focus:ring-[#202124]/30 dark:focus:ring-white/30 hover:bg-black/5 dark:hover:bg-white/10 transition-colors"
        aria-controls="navbar-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú principal</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          />
        </svg>
      </button>
    </div>

    <!-- Desktop menu + mobile dropdown container -->
    <div
      class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1 space-x-4"
      id="navbar-menu"
    >
      <ul
        class="font-medium flex flex-col md:flex-row md:space-x-8 p-4 mt-4 md:p-0 md:mt-0 border-2 border-[#202124] dark:border-white rounded-xl md:border-0 bg-white dark:bg-[#202124] md:bg-transparent"
      >
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`block py-2 transition-colors duration-150 ${link.hoverClass}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>

      <div class="h-8 hidden md:flex items-center">
        <ThemeToggle client:load />
      </div>
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById("navbar-toggle-btn")
  const menu = document.getElementById("navbar-menu")

  if (toggleBtn && menu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true"
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded))
      menu.classList.toggle("hidden")
    })

    const links = menu.querySelectorAll("a")
    for (const link of links) {
      link.addEventListener("click", () => {
        if (!menu.classList.contains("hidden")) {
          menu.classList.add("hidden")
          toggleBtn.setAttribute("aria-expanded", "false")
        }
      })
    }
  }
</script>
