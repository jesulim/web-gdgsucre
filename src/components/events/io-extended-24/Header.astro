---
import IOExtended from "./icons/IOExtended.astro"
import IOExtendedShort from "./icons/IOExtended-short.astro"
import { ThemeToggle } from "./ThemeToggle"

const navLinks = [
  { name: "Speakers", href: "#speakers", hoverClass: "hover:text-blue-500" },
  { name: "Agenda", href: "#agenda", hoverClass: "hover:text-orange-500" },
  { name: "Equipo", href: "#organizadores", hoverClass: "hover:text-purple-500" },
  { name: "Eventos Pasados", href: "/eventos", hoverClass: "hover:text-red-500" },
]
---

<nav
  class="fixed w-full z-30 top-0 left-0 border-b-2 border-black bg-[#EEEEEE] dark:bg-[#1f2123] dark:text-white dark:border-white transition-colors duration-200"
>
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-4 sm:px-6 py-5 sm:py-6">
    <a href="#hero" aria-label="Volver al inicio" class="flex items-center">
      <div class="block md:hidden">
        <IOExtendedShort />
      </div>
      <div class="hidden md:block">
        <IOExtended class="w-48 sm:w-56 lg:w-64 h-auto text-black dark:text-white" />
      </div>
    </a>

    <!-- Menú Desktop + Toggle con ícono original a la derecha -->
    <div class="hidden md:flex items-center gap-6 lg:gap-8">
      <ul class="flex items-center space-x-6 lg:space-x-8 text-sm lg:text-base font-medium text-black dark:text-white">
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`transition-colors duration-150 ${link.hoverClass}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center">
        <ThemeToggle client:load />
      </div>
    </div>

    <!-- Menú Mobile: Toggle y Botón hamburguesa -->
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle client:load />

      <button
        id="navbar-toggle-btn"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-black dark:text-white rounded-lg hover:bg-neutral-300/60 dark:hover:bg-neutral-800 focus:outline-none focus:ring-2 focus:ring-neutral-400"
        aria-controls="navbar-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú principal</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          />
        </svg>
      </button>
    </div>

    <!-- Dropdown Mobile -->
    <div
      class="items-center justify-between hidden w-full md:hidden"
      id="navbar-menu"
    >
      <ul
        class="font-medium flex flex-col p-4 mt-3 border-2 border-black dark:border-white rounded-2xl bg-white dark:bg-[#1f2123] shadow-md space-y-2"
      >
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class={`block py-2 px-3 text-neutral-800 dark:text-neutral-200 transition-colors font-medium rounded-lg ${link.hoverClass}`}
            >
              {link.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById("navbar-toggle-btn")
  const menu = document.getElementById("navbar-menu")

  if (toggleBtn && menu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true"
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded))
      menu.classList.toggle("hidden")
    })

    const links = menu.querySelectorAll("a")
    for (const link of links) {
      link.addEventListener("click", () => {
        if (!menu.classList.contains("hidden")) {
          menu.classList.add("hidden")
          toggleBtn.setAttribute("aria-expanded", "false")
        }
      })
    }
  }
</script>
