---
import { ModeToggle } from "@/components/ModeToggle"
import IOExtended from "./icons/IOExtended.astro"
import IOExtendedShort from "./icons/IOExtended-short.astro"

const navLinks = [
  { name: "Sobre el evento", href: "#about" },
  { name: "Speakers", href: "#speakers" },
  { name: "Agenda", href: "#agenda" },
  { name: "Sponsors", href: "#sponsors" },
  { name: "Organizadores", href: "#organizadores" },
]
---

<nav
  class="fixed w-full z-30 top-0 left-0 border-b-2 border-black bg-neutral-100/90 dark:bg-neutral-900/90 backdrop-blur-md dark:text-white dark:border-white transition-colors duration-200"
>
  <div class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto p-4">
    <a href="#hero" aria-label="Volver al inicio" class="flex items-center">
      <div class="block md:hidden">
        <IOExtendedShort />
      </div>
      <div class="hidden md:block">
        <IOExtended />
      </div>
    </a>

    <div class="flex items-center gap-2 md:order-2">
      <ModeToggle client:load />

      <button
        id="navbar-toggle-btn"
        type="button"
        class="inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-neutral-600 rounded-lg md:hidden hover:bg-neutral-200 focus:outline-none focus:ring-2 focus:ring-neutral-400 dark:text-neutral-300 dark:hover:bg-neutral-800"
        aria-controls="navbar-menu"
        aria-expanded="false"
      >
        <span class="sr-only">Abrir menú principal</span>
        <svg
          class="w-5 h-5"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 17 14"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 1h15M1 7h15M1 13h15"
          />
        </svg>
      </button>
    </div>

    <div
      class="items-center justify-between hidden w-full md:flex md:w-auto md:order-1"
      id="navbar-menu"
    >
      <ul
        class="font-medium flex flex-col md:flex-row md:space-x-8 p-4 mt-4 md:p-0 md:mt-0 border-2 border-black md:border-0 rounded-2xl bg-white dark:bg-neutral-900 md:bg-transparent shadow-sm md:shadow-none"
      >
        {navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="block py-2 px-3 text-neutral-800 dark:text-neutral-200 hover:text-blue-500 dark:hover:text-blue-400 transition-colors font-medium"
            >
              {link.name}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/eventos"
            class="block py-2 px-3 text-neutral-800 dark:text-neutral-200 hover:text-blue-500 dark:hover:text-blue-400 transition-colors font-medium"
          >
            Otros Eventos
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script>
  const toggleBtn = document.getElementById("navbar-toggle-btn")
  const menu = document.getElementById("navbar-menu")

  if (toggleBtn && menu) {
    toggleBtn.addEventListener("click", () => {
      const isExpanded = toggleBtn.getAttribute("aria-expanded") === "true"
      toggleBtn.setAttribute("aria-expanded", String(!isExpanded))
      menu.classList.toggle("hidden")
    })

    // Close menu when clicking any nav link
    const links = menu.querySelectorAll("a")
    for (const link of links) {
      link.addEventListener("click", () => {
        if (!menu.classList.contains("hidden")) {
          menu.classList.add("hidden")
          toggleBtn.setAttribute("aria-expanded", "false")
        }
      })
    }
  }
</script>
