---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import BoliviaFlag from "@/assets/events/io-extended-24/bolivia-flag.svg"

interface Props {
  id: number
  name: string
  location: string
  image?: ImageMetadata
}

const { id, name, location, image } = Astro.props
---

<div
  class="group p-4 border-2 border-black dark:border-white bg-white dark:bg-neutral-900 rounded-3xl flex flex-col justify-between space-y-4 h-full shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] dark:shadow-[3px_3px_0px_0px_rgba(255,255,255,1)] hover:-translate-y-1 hover:shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] dark:hover:shadow-[5px_5px_0px_0px_rgba(255,255,255,1)] transition-all duration-200"
>
  <div class="overflow-hidden rounded-2xl bg-neutral-100 dark:bg-neutral-800 flex items-center justify-center p-2">
    {image ? (
      <Image
        src={image}
        alt={name}
        width={300}
        height={300}
        class="w-full max-w-44 aspect-square object-contain mx-auto group-hover:scale-105 transition-transform duration-300"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="w-full max-w-44 aspect-square bg-neutral-200 dark:bg-neutral-700 rounded-2xl flex items-center justify-center text-neutral-400">
        Sin foto
      </div>
    )}
  </div>

  <div class="text-center space-y-1">
    <h3 class="text-neutral-900 dark:text-white font-bold text-base sm:text-lg md:text-xl line-clamp-2">
      {name}
    </h3>
    <div class="flex items-center justify-center gap-2 pt-1">
      <BoliviaFlag class="w-5 h-3.5 object-contain" />
      <p class="text-neutral-600 dark:text-neutral-300 text-xs sm:text-sm font-medium">
        {location}
      </p>
    </div>
  </div>
</div>
