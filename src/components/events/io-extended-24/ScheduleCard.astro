---
interface Props {
  time: string
  title: string
  speaker?: string
  type?: "talk" | "workshop"
}

const { time, title, speaker } = Astro.props
const textColor = !speaker ? "text-[#4285F4] font-semibold" : ""
---

<div class="py-2.5 w-full md:w-80 lg:w-[31rem] space-y-1">
  <p class="w-40 font-semibold font-sofia text-base text-[#4285F4]">
    {time}
  </p>
  <p class={`font-medium text-base lg:text-xl leading-5 ${textColor}`}>
    {title}
  </p>
  {speaker && <p class="text-sm lg:text-base text-neutral-700 dark:text-neutral-300">{speaker}</p>}
</div>
