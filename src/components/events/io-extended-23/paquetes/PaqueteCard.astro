---
import { Image } from "astro:assets"
import soldOutImage from "@/assets/io-extended-23/paquetes/sold-out.webp"

const { title, color, price, items, img = "", soldOut } = Astro.props

import angular from "@/assets/io-extended-23/paquetes/angular.webp"
import firebase from "@/assets/io-extended-23/paquetes/firebase.webp"
import flutter from "@/assets/io-extended-23/paquetes/flutter.webp"
import tensorflow from "@/assets/io-extended-23/paquetes/tensorflow.webp"

const textColor = color === "bg-yellow-500" ? "text-black" : "text-white"

const bundleImg = {
  angular: angular,
  firebase: firebase,
  flutter: flutter,
  tensorflow: tensorflow,
}
---

<div class:list={['rounded-2xl h-96 border-2 border-black md:h-80', color]}>
  <div class:list={['p-3', textColor]}>
    <div class='flex items-start justify-between mb-1'>
      <h3 class='text-xl md:text-2xl font-semibold'>
        Paquete <span class='font-bold'>
          {title}
        </span>
      </h3>
      <span
        class='whitespace-nowrap rounded-full border-2 px-2 text-black border-black bg-white'
      >
        {price} Bs.</span
      >
    </div>

    <div class='flex flex-col justify-between pl-6 sm:flex-row'>
      <ul class='list list-disc text-sm md:text-lg z-1'>
        <li>Manilla QR</li>
        <li>Refrigerio</li>
        <li>Stickers</li>
        <li>Llavero</li>
        <li>Cuaderno</li>
        {items?.map(item => <li class='font-semibold'>{item}</li>)}
      </ul>

      <div
        class='z-0 absolute bottom-8 right-16 xl:right-20 w-5/12 sm:w-1/3 lg:w-1/4'
      >
        <Image
          class='object-cover w-full transform custom-scale-200'
          src={bundleImg[img]}
          alt='angular'
        />
      </div>
    </div>
  </div>
  {
    soldOut && (
      <div class='bg-[#fafafa80] rounded-2xl flex absolute inset-0.5 z-20 '>
        <Image
          class='w-3/4 mx-auto my-auto opacity-100'
          src={soldOutImage}
          alt='sold out'
        />
      </div>
    )
  }
</div>

<style>
  .custom-scale-200 {
    transform: scale(2);
  }
</style>
