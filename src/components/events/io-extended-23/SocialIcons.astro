---
import Facebook from "@/assets/icons/social/Facebook.svg"
import Instagram from "@/assets/icons/social/Instagram.svg"
import Linkedin from "@/assets/icons/social/Linkedin.svg"
import Tiktok from "@/assets/icons/social/Tiktok.svg"
import Twitter from "@/assets/icons/social/Twitter.svg"

const socialIcons = [
  {
    icon: Facebook,
    link: "https://www.facebook.com/gdgsucre",
    alt: "Facebook",
  },
  {
    icon: Instagram,
    link: "https://www.instagram.com/gdgsucre",
    alt: "Instagram",
  },
  {
    icon: Twitter,
    link: "https://twitter.com/gdg_sucre",
    alt: "Twitter",
  },
  {
    icon: Tiktok,
    link: "https://www.tiktok.com/@gdgsucre?lang=en",
    alt: "TikTok",
  },
  {
    icon: Linkedin,
    link: "https://www.linkedin.com/company/gdgsucre",
    alt: "LinkedIn",
  },
]
---

<div class="mt-4 flex items-center space-x-10 sm:mt-0 sm:justify-center">
  {
    socialIcons.map(({ icon: Icon, link, alt }) => (
      <a
        class="text-gray-500 hover:text-white"
        href={link}
        target="_blank"
        rel="noreferrer"
        aria-label={alt}
      >
        <Icon class="h-5 w-5" aria-hidden="true" />
      </a>
    ))
  }
</div>
