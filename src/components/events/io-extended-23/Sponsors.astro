---
import { Image } from "astro:assets"
import droBots from "@/assets/events/io-extended-23/sponsors/dro-bots.webp"

import facultadEconomia from "@/assets/events/io-extended-23/sponsors/facultad-economia.webp"
import itGroup from "@/assets/events/io-extended-23/sponsors/it-group.webp"
import itera from "@/assets/events/io-extended-23/sponsors/itera.webp"
import jetbrains from "@/assets/events/io-extended-23/sponsors/jetbrains.webp"
import magisterioRural from "@/assets/events/io-extended-23/sponsors/magisterio-rural.webp"
import xyz from "@/assets/events/io-extended-23/sponsors/xyz.webp"
import SectionTitle from "./SectionTitle.astro"

const sponsors = [
  {
    name: "itera soluciones digitales",
    logo: itera,
    url: "https://www.facebook.com/profile.php?id=100063753325772",
  },
  {
    name: "Dro-bots accesorios para robótica y electrónica",
    logo: droBots,
    url: "https://www.facebook.com/profile.php?id=100083024454287",
  },
  {
    name: "Facultad de Ciencias Económicas y Empresariales",
    logo: facultadEconomia,
    url: "https://economicas.usfx.bo/",
  },
  {
    name: "XYZ Sistema Profesional de Sonido y Luces",
    logo: xyz,
    url: "https://www.facebook.com/profile.php?id=100057052885906&mibextid=ZbWKwL",
  },
  {
    name: "ITGroup Systems",
    logo: itGroup,
    url: "https://www.facebook.com/ITGroupSystems/",
  },
  {
    name: "Cooperativa de Ahorro y Crédito Abierta Magisterio Rural de Chuquisaca R.L.",
    logo: magisterioRural,
    url: "https://www.facebook.com/CMRChuq/",
  },
  {
    name: "JetBrains",
    logo: jetbrains,
    url: "https://www.facebook.com/JetBrains",
  },
]
---

<SectionTitle id="sponsors" title="Sponsors" />
<div class="max-w-screen-md px-2 mx-auto grid grid-cols-2 gap-4 md:grid-cols-3">
  {
    sponsors.map(sponsor => (
      <div class="flex justify-center items-center">
        <a href={sponsor.url} target="_blank">
          <Image src={sponsor.logo} alt={sponsor.name} />
        </a>
      </div>
    ))
  }
</div>
