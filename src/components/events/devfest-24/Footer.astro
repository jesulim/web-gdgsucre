---
import GDGSucreLogo from "./icons/GDGSucreLogo.astro"
import SocialIcons from "./icons/SocialIcons.astro"
---

<footer class="relative border-t-2 border-black bg-[#EEEEEE] dark:border-white dark:bg-[#202124] dark:text-white lg:mt-12">
  <div class="mx-auto max-w-screen-2xl p-4 pb-16 pt-6 lg:py-8">
    <div class="flex flex-col items-center justify-between space-y-4 font-medium lg:flex-row lg:space-y-0">
      <GDGSucreLogo />

      <a href="/eventos" class="hover:text-[#4285F4] lg:mx-8">
        Eventos Pasados
      </a>

      <a
        href="https://developers.google.com/community-guidelines"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-[#4285F4] lg:mr-auto"
      >
        Lineamientos de la comunidad
      </a>

      <SocialIcons />
    </div>
  </div>
</footer>
