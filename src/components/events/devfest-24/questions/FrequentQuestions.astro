---
import frequentQuestions from "@/data/devfest-24/frequentQuestions.json"
import SectionTitle from "../SectionTitle.astro"
---

<section class="questions flex justify-center">
  <SectionTitle id="faq" title="Preguntas Frecuentes" />
</section>

<div class="mx-auto mb-8 grid max-w-screen-2xl place-content-center px-4 pb-3">
  <!-- Contenedor en dos columnas para pantallas grandes y una columna para pantallas pequeñas -->
  <div class="flex w-full flex-col justify-between lg:flex-row lg:space-x-4">
    <div class="py-custom space-y-4 px-1 lg:w-1/2 lg:px-5">
      <div class="faq-container">
        <div class="faq-list">
          {
            frequentQuestions.slice(0, Math.ceil(frequentQuestions.length / 2)).map((faq) => (
              <div class="cut-corners-r bg-black p-0.5 dark:bg-white">
                <div class="cut-corners-r h-full bg-[#FBBC04] pb-2 pr-2">
                  <div class="faq-card flex h-full items-center border-b-2 border-r-2 border-black bg-white px-4 py-4 text-black dark:border-white dark:bg-[#202124] dark:text-white">
                    <div class="faq-item w-full">
                      <button type="button" class="faq-question">
                        <span>{faq.question}</span>
                        <span class="icon shrink-0 ml-2" />
                      </button>
                      <div class="faq-answer closed-answer">
                        <p class="text-sm sm:text-base">{faq.answer}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <div class="py-custom-2 space-y-4 px-1 lg:w-1/2 lg:px-5">
      <div class="faq-container">
        <div class="faq-list">
          {
            frequentQuestions.slice(Math.ceil(frequentQuestions.length / 2)).map((faq) => (
              <div class="cut-corners-r bg-black p-0.5 dark:bg-white">
                <div class="cut-corners-r h-full bg-[#FBBC04] pb-2 pr-2">
                  <div class="faq-card flex h-full items-center border-b-2 border-r-2 border-black bg-white px-4 py-4 text-black dark:border-white dark:bg-[#202124] dark:text-white">
                    <div class="faq-item w-full">
                      <button type="button" class="faq-question">
                        <span>{faq.question}</span>
                        <span class="icon shrink-0 ml-2" />
                      </button>
                      <div class="faq-answer closed-answer">
                        <p class="text-sm sm:text-base">{faq.answer}</p>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .faq-card {
    background-color: #ffffff;
    color: #000000;
    border-color: #000000;
  }

  :global(.dark) .faq-card {
    background-color: #202124 !important;
    color: #ffffff !important;
    border-color: #ffffff !important;
  }

  :global(.dark) .faq-card .faq-question,
  :global(.dark) .faq-card .faq-answer p {
    color: #ffffff !important;
  }

  :global(.dark) .faq-card .icon::before,
  :global(.dark) .faq-card .icon::after {
    background: #ffffff !important;
  }

  .questions {
    margin: 0.5rem 0;
  }

  .faq-list {
    max-width: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-question {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-size: 1.125rem;
    font-weight: 600;
    color: inherit;
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    padding: 0 0.5rem;
  }

  .faq-answer p {
    margin: 0;
    padding-bottom: 0.5rem;
    line-height: 1.6;
    color: inherit;
    opacity: 0.9;
  }

  .faq-item.active .faq-answer {
    max-height: 500px;
    transition: max-height 0.5s ease-in;
  }

  .icon {
    width: 20px;
    height: 20px;
    position: relative;
    transition: transform 0.3s ease;
  }

  .icon::before,
  .icon::after {
    content: "";
    position: absolute;
    background: currentColor;
    border-radius: 2px;
  }

  .icon::before {
    width: 2px;
    height: 20px;
    left: 9px;
    top: 0;
  }

  .icon::after {
    width: 20px;
    height: 2px;
    left: 0;
    top: 9px;
  }

  .faq-item.active .icon::before {
    transform: rotate(90deg);
    opacity: 0;
  }

  @media (max-width: 640px) {
    .faq-container {
      padding: 0 0.5rem 1rem;
    }
    .faq-question {
      font-size: 1rem;
    }
  }

  @media (min-width: 768px) and (max-width: 1180px) {
    .py-custom-2 {
      padding: 1rem;
    }
    .py-custom {
      padding: 1rem 1rem 0;
    }
  }
</style>

<script>
  function setupFaq() {
    const questions = document.querySelectorAll(".faq-question")
    questions.forEach((question) => {
      if ((question as HTMLElement).dataset.faqBound) return
      ;(question as HTMLElement).dataset.faqBound = "true"
      question.addEventListener("click", () => {
        const faqItem = question.closest(".faq-item")
        if (faqItem) {
          faqItem.classList.toggle("active")
        }
      })
    })
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFaq)
  } else {
    setupFaq()
  }
</script>
