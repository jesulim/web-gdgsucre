---
import { Image } from "astro:assets"
import tenMinds from "@/assets/sponsors/10minds.webp"
import delve from "@/assets/sponsors/delve.webp"
import dh from "@/assets/sponsors/dh.webp"
import droBots from "@/assets/sponsors/dro-bots.webp"
import helvetas from "@/assets/sponsors/helvetas.webp"
import jetBrains from "@/assets/sponsors/jetbrains.webp"
import napp from "@/assets/sponsors/napp.webp"
import sistemaEmprendedor from "@/assets/sponsors/sistema_emprendedor.webp"
import SectionTitle from "./SectionTitle.astro"

const sponsors = [
  {
    name: "Digital Harbor",
    logo: dh,
    url: "https://digitalharborbolivia.com/",
    class: "p-2 md:p-4 md:col-span-2",
  },
  {
    name: "10minds",
    logo: tenMinds,
    url: "https://10minds.org/",
    class: "md:p-2",
  },
  {
    name: "JetBrains",
    logo: jetBrains,
    url: "https://www.jetbrains.com/",
    class: "p-4 col-span-2",
  },
  {
    name: "Dro-Bots",
    logo: droBots,
    url: "http://dro-bots.com/",
    class: "p-4 col-span-2",
  },
  {
    name: "NAPP",
    logo: napp,
    url: "https://fundacion-napp.org/",
    class: "p-2 sm:p-8 md:col-span-2",
  },
  {
    name: "Delve",
    logo: delve,
    url: "https://delveedu.com/",
    class: "",
  },
  {
    name: "Helvetas Bolivia",
    logo: helvetas,
    url: "https://www.helvetas.org/es/bolivia",
    class: "p-4 col-span-2",
  },
  {
    name: "Sistema Emprendedor Sucre",
    logo: sistemaEmprendedor,
    url: "https://sistema-emprendedor-sucre.web.app/",
    class: "p-6 col-span-2",
  },
]
---

<style>
  .bg-sponsors-bg {
    background-image: url("data:image/svg+xml,%3Csvg%20width%3D'97'%20height%3D'95'%20viewBox%3D'0%200%2097%2095'%20fill%3D'none'%20xmlns%3D'http%3A//www.w3.org/2000/svg'%3E%3Cpath%20d%3D'M28.7035%2022.7882C34.7129%2022.7667%2039.6021%2026.7287%2039.6193%2031.6392C39.6365%2036.5498%2034.7774%2040.5504%2028.7679%2040.5719'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M28.6388%205.00009C34.6482%204.97862%2039.5373%208.94057%2039.5545%2013.8512C39.5717%2018.7617%2034.7126%2022.7623%2028.7031%2022.7838'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M20.8092%2038.6232L5%2022.814L20.8092%207.00488'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M80.6254%2022.7882C86.6348%2022.7667%2091.5238%2026.7287%2091.541%2031.6392C91.5582%2036.5498%2086.6992%2040.5504%2080.6897%2040.5719'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M80.5608%205.00009C86.5703%204.97862%2091.4594%208.94057%2091.4765%2013.8512C91.4937%2018.7617%2086.6347%2022.7623%2080.6253%2022.7838'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M72.7312%2038.6232L56.922%2022.814L72.7312%207.00488'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M67.838%2071.356C61.8285%2071.3774%2056.9393%2067.4155%2056.9221%2062.5049C56.905%2057.5943%2061.7641%2053.5937%2067.7735%2053.5723'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M67.9066%2089.1397C61.8971%2089.1611%2057.008%2085.1992%2056.9908%2080.2886C56.9737%2075.378%2061.8327%2071.3774%2067.8422%2071.356'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M75.7363%2055.5166L91.5455%2071.3301L75.7363%2087.1349'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M15.9159%2071.356C9.90641%2071.3774%205.01722%2067.4155%205.00005%2062.5049C4.98288%2057.5943%209.84196%2053.5937%2015.8514%2053.5723'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M15.9849%2089.1397C9.97543%2089.1611%205.08634%2085.1992%205.06917%2080.2886C5.052%2075.378%209.91109%2071.3774%2015.9205%2071.356'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3Cpath%20d%3D'M23.8143%2055.5166L39.6235%2071.3301L23.8143%2087.1349'%20stroke%3D'%231E1E1E'%20stroke-width%3D'3'%20stroke-miterlimit%3D'10'%20stroke-linejoin%3D'round'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-position: center;
    background-color: #f9ab00;
  }
</style>

<SectionTitle id="sponsors" title="Sponsors" />

<section class="bg-sponsors-bg border-y-4 border-black dark:border-black md:my-4">
  <div class="mx-auto grid max-w-screen-lg grid-cols-2 gap-8 p-4 sm:p-8 md:grid-cols-5">
    {
      sponsors.map((sponsor) => (
        <a
          href={sponsor.url}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            "flex h-36 items-center justify-center border-4 border-black bg-white transition-all duration-200 hover:-translate-x-1 hover:-translate-y-1 hover:scale-105 hover:shadow-[8px_8px_0px_0px_black]",
            sponsor.class,
          ]}
        >
          <Image src={sponsor.logo} alt={sponsor.name} class="h-28 object-contain" />
        </a>
      ))
    }
  </div>
</section>
