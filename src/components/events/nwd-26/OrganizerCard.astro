---
interface Props {
  full_name: string
  role: string
  img: string
  social?: {
    linkedin?: string
    instagram?: string
    facebook?: string
    github?: string
  }
}

const { full_name, role, img, social } = Astro.props
---

<article
  class="relative bg-white rounded-3xl border border-[#e4ebf7] h-80 w-56 overflow-hidden"
>
  <div class="absolute top-0 left-0 right-0">
    <div
      class="w-full h-18 rounded-t-3xl"
      style="background: linear-gradient(45deg, #EAF2FE 0%, #E3F7FA 100%);"
    >
    </div>
    <!-- Cinta decorativa superior (estilo NWD) -->
    <div
      class="h-2 z-0 opacity-80"
      style="background-image: repeating-linear-gradient(45deg, rgba(255,255,255,0.85) 0 4px, transparent 4px 8px), repeating-linear-gradient(90deg, #1355CC 0 20px, #10A7BC 20px 40px, #F6BE3A 40px 50px, #0B3FA0 50px 70px);"
      aria-hidden="true"
    >
    </div>
  </div>
  <div
    class="relative rounded-3xl flex flex-col items-center text-center h-full w-full z-10 px-3"
  >
    <!-- Foto / Avatar circular -->
    <div
      class="relative z-10 w-32 h-32 rounded-full overflow-hidden border-4 border-white bg-white shadow-sm flex items-center justify-center shrink-0 m-3"
    >
      {
        img ? (
          <img
            src={img}
            alt={full_name}
            class="w-full h-full object-cover"
            loading="lazy"
          />
        ) : (
          <span class="font-google font-bold text-xl text-nwd-blue">
            {full_name.charAt(0)}
          </span>
        )
      }
    </div>

    <!-- Nombre y Rol -->
    <div class="flex-1 flex flex-col justify-center h-min">
      <h3
        class="font-google font-bold text-xl text-nwd-ink leading-tight mb-1 line-clamp-2"
      >
        {full_name}
      </h3>
      <p class="font-google text-sm text-slate-500 line-clamp-1">
        {role}
      </p>
    </div>

    <!-- Enlaces de redes sociales (in / ig como en Figma) -->
    {
      social && (
        <div class="flex items-center justify-center gap-2 mt-3 mb-4">
          {social.linkedin && (
            <a
              href={social.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="w-7 h-7 rounded-full border border-slate-200 text-nwd-blue hover:border-nwd-blue flex items-center justify-center font-google text-xs font-semibold transition-colors"
              aria-label={`LinkedIn de ${full_name}`}
            >
              in
            </a>
          )}
          {social.instagram && (
            <a
              href={social.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="w-7 h-7 rounded-full border border-slate-200 text-nwd-teal hover:border-nwd-teal flex items-center justify-center font-google text-xs font-semibold transition-colors"
              aria-label={`Instagram de ${full_name}`}
            >
              ig
            </a>
          )}
          {social.facebook && (
            <a
              href={social.facebook}
              target="_blank"
              rel="noopener noreferrer"
              class="w-7 h-7 rounded-full border border-slate-200 text-nwd-blue hover:border-nwd-blue hover:text-nwd-blue flex items-center justify-center font-google text-xs font-semibold transition-colors"
              aria-label={`Facebook de ${full_name}`}
            >
              fb
            </a>
          )}
        </div>
      )
    }
  </div>
</article>
