---
import { Image } from "astro:assets"
import type { EventPackage } from "@/data/nwd-26/packages"
import { PackageFeatureIcon } from "./PackageFeatureIcon"

interface Props {
  packageData: EventPackage
}

const { packageData } = Astro.props
---

<article class:list={["package-card", `package-card--${packageData.accent}`, packageData.featured && "package-card--featured", packageData.id === "juana" && "package-card--juana"]}>
  <div class="package-card__ribbon" aria-hidden="true"></div>
  <span class="package-card__square package-card__square--one" aria-hidden="true"></span>
  <span class="package-card__square package-card__square--two" aria-hidden="true"></span>

  <div class="package-card__body">
    <p class="package-card__label">PAQUETE #{packageData.packageNumber}</p>
    <div class="package-card__identity">
      <div class="package-card__name">
        <h3>{packageData.firstName}</h3>
        <p>{packageData.lastName}</p>
      </div>
      <div class="package-card__portrait-wrap" aria-hidden="true">
        <Image src={packageData.image} alt={packageData.imageAlt} widths={[280, 400, 560]} sizes="(max-width: 767px) 210px, (max-width: 1279px) 260px, 230px" loading="lazy" decoding="async" class="package-card__portrait" />
      </div>
    </div>

    <p class="package-card__description">{packageData.description}</p>
    <span class="package-card__rule" aria-hidden="true"></span>
    <p class="package-card__price"><span>Bs.</span>{packageData.price}</p>

    <ul class="package-card__features">
      {packageData.features.map(feature => <li><span class="package-card__icon"><PackageFeatureIcon type={feature.type} /></span><span>{feature.label}</span></li>)}
    </ul>
  </div>
</article>

<style>
  .package-card { position: relative; display: flex; min-width: 0; min-height: 600px; overflow: hidden; border: 1px solid rgba(19, 85, 204, .1); border-radius: 22px; background: #fff; box-shadow: 0 12px 30px rgba(11,46,107,.075); }
  .package-card--featured { border-color: #f6be3a; background: linear-gradient(135deg,#fffdf7 0%,#fff 60%); box-shadow: 0 18px 38px rgba(135,95,18,.16); }
  .package-card__ribbon { position: absolute; inset: 0 0 auto; height: 8px; background-image: repeating-linear-gradient(45deg,rgba(255,255,255,.85) 0 5px,transparent 5px 11px), repeating-linear-gradient(-45deg,rgba(255,255,255,.85) 0 5px,transparent 5px 11px), repeating-linear-gradient(90deg,#1355cc 0 22px,#10a7bc 22px 44px,#f6be3a 44px 56px,#0b3fa0 56px 78px); }
  .package-card__square { position: absolute; display: block; width: 14px; height: 14px; }
  .package-card__square--one { top: 35px; right: 30px; background: #f6be3a; }
  .package-card__square--two { top: 93px; right: 60px; width: 10px; height: 10px; background: #10a7bc; }
  .package-card--featured .package-card__square--two { background: #1355cc; }
  .package-card__body { position: relative; z-index: 1; display: flex; width: 100%; flex-direction: column; padding: 30px 26px 28px; }
  .package-card__label { margin: 0; color: #1355cc; font-size: 11px; font-weight: 700; letter-spacing: .24em; }
  .package-card__identity { position: relative; min-height: 212px; margin-top: 14px; }
  .package-card__name { position: relative; z-index: 1; max-width: 68%; }
  h3 { margin: 0; color: #0b2e6b; font-size: clamp(34px,3.1vw,44px); font-weight: 700; line-height: .88; letter-spacing: -.055em; }
  .package-card__name p { margin: 5px 0 0; color: #10a7bc; font-family: Georgia, serif; font-size: clamp(38px,3.5vw,50px); font-style: italic; font-weight: 700; line-height: .82; letter-spacing: -.065em; }
  .package-card__portrait-wrap { position: absolute; right: -21px; bottom: 0; display: grid; width: 190px; height: 190px; place-items: end center; overflow: hidden; border-radius: 50%; background: rgba(19,85,204,.08); }
  .package-card--yellow .package-card__portrait-wrap { background: rgba(246,190,58,.16); }
  .package-card--turquoise .package-card__portrait-wrap { background: rgba(16,167,188,.11); }
  .package-card__portrait { display: block; width: 215px; max-width: none; height: 218px; object-fit: contain; object-position: bottom; pointer-events: none; user-select: none; }
  .package-card__description { max-width: 285px; margin: 14px 0 0; color: #4b6593; font-size: 15px; line-height: 1.5; text-wrap: pretty; }
  .package-card__rule { display: block; width: 56px; height: 6px; margin-top: 17px; border-radius: 4px; background: #f6be3a; }
  .package-card__price { display: inline-flex; width: fit-content; align-items: baseline; gap: 7px; margin: 20px 0 0; padding: 9px 18px 10px; border-radius: 12px; background: #1355cc; box-shadow: 0 8px 18px rgba(19,85,204,.16); color: white; font-size: 41px; font-weight: 700; line-height: 1; letter-spacing: -.055em; }
  .package-card__price span { font-size: 18px; letter-spacing: -.02em; }
  .package-card--yellow .package-card__price { background: #f6be3a; color: #0b2e6b; box-shadow: 0 8px 18px rgba(183,133,30,.15); }
  .package-card--turquoise .package-card__price { background: #10a7bc; }
  .package-card__features { display: grid; gap: 11px; margin: 24px 0 0; padding: 0; list-style: none; }
  .package-card__features li { display: flex; align-items: flex-start; gap: 11px; color: #0b2e6b; font-size: 15px; font-weight: 600; line-height: 1.35; }
  .package-card__icon { display: grid; width: 28px; height: 28px; flex: 0 0 auto; place-items: center; border-radius: 8px; background: rgba(19,85,204,.07); }
  .package-card--juana .package-card__identity { min-height: 255px; }
  .package-card--juana .package-card__portrait-wrap { width: 215px; height: 215px; }
  .package-card--juana .package-card__portrait { width: 246px; height: 251px; }
  .package-card--juana .package-card__features { margin-top: auto; padding-top: 28px; }
  @media (min-width: 1280px) { .package-card--featured { transform: translateY(-10px); } }
  @media (max-width: 767px) { .package-card { min-height: 0; } .package-card__body { padding: 28px 22px 24px; } .package-card__portrait-wrap { width: 174px; height: 174px; } .package-card__portrait { width: 198px; height: 202px; } .package-card--juana .package-card__identity { min-height: 225px; } .package-card--juana .package-card__portrait-wrap { width: 188px; height: 188px; } .package-card--juana .package-card__portrait { width: 214px; height: 219px; } }
  @media (prefers-reduced-motion: reduce) { .package-card { transform: none; } }
</style>
