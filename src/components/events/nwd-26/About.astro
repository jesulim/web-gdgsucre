---
// Pixel-art icons on a 7x7 grid. Each character maps to a color in `palette`; "." is empty.
const pillars = [
  {
    title: "Inspírate",
    description: "Escucha historias de mujeres bolivianas que ya están abriendo camino.",
    block: "#F6BE3A",
    shadow: "#0B3FA0",
    palette: { "#": "#0B2E6B", w: "#FFFFFF" },
    icon: ["...#...", "..#w#..", "#######", ".#####.", "..###..", ".##.##.", ".#...#."],
  },
  {
    title: "Aprende",
    description: "Llévate ideas concretas para dar tu siguiente paso en tecnología.",
    block: "#10A7BC",
    shadow: "#F6BE3A",
    palette: { "#": "#F6BE3A", w: "#FFFFFF", o: "#0B2E6B" },
    icon: ["..###..", ".#w###.", ".#w###.", ".#####.", "..###..", "..ooo..", "...o..."],
  },
  {
    title: "Conecta",
    description: "Encuentra una comunidad que te acompaña antes, durante y después.",
    block: "#1355CC",
    shadow: "#10A7BC",
    palette: { "#": "#FFFFFF", w: "#BBD5FB" },
    icon: [".......", ".##.##.", "#w#####", "#######", ".#####.", "..###..", "...#..."],
  },
]

// Pixels appear in a diagonal sweep, from the top-left corner.
const toPixels = (icon: string[], palette: Record<string, string>) =>
  icon.flatMap((row, y) =>
    [...row].flatMap((cell, x) =>
      cell === "." ? [] : [{ x, y, fill: palette[cell], delay: (x + y) * 35 }]
    )
  )
---

<section
  id="sobre-el-evento"
  class="relative z-[1] px-4 sm:px-6 lg:px-14 pt-6 md:pt-10 pb-16 md:pb-20 lg:pb-24"
  aria-labelledby="about-title"
>
  <div
    class="max-w-[1040px] mx-auto grid grid-cols-1 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] items-center gap-12 md:gap-14 lg:gap-20"
  >
    <header>
      <p class="about__eyebrow">Sobre el evento</p>
      <h2 id="about-title">Un encuentro para las mujeres que impulsan</h2>
      <div class="about__rule" aria-hidden="true"></div>
      <p class="about__intro">
        En Ellas Late Bolivia reúne a mujeres que sueñan, crean y construyen su futuro en
        tecnología. Vengas de donde vengas, aquí hay un lugar para ti.
      </p>
    </header>

    <about-steps>
      <ol class="about__steps">
        {
          pillars.map((pillar, index) => (
            <li
              class="about__step"
              style={`--step: ${index}; --block: ${pillar.block}; --shadow: ${pillar.shadow};`}
            >
              <span class="about__block" aria-hidden="true">
                <svg viewBox="0 0 7 7" shape-rendering="crispEdges">
                  {toPixels(pillar.icon, pillar.palette).map(pixel => (
                    <rect
                      x={pixel.x}
                      y={pixel.y}
                      width="1"
                      height="1"
                      fill={pixel.fill}
                      style={`--delay: ${index * 180 + pixel.delay}ms;`}
                    />
                  ))}
                </svg>
              </span>
              <div class="about__text">
                <span class="about__number">0{index + 1}</span>
                <h3>{pillar.title}</h3>
                <p>{pillar.description}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </about-steps>
  </div>
</section>

<style>
  .about__eyebrow {
    margin: 0 0 10px;
    color: #10a7bc;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.34em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: #1355cc;
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .about__rule {
    width: 72px;
    height: 6px;
    margin: 22px 0;
    border-radius: 4px;
    background: #f6be3a;
  }

  .about__intro {
    margin: 0;
    color: #4b6593;
    font-size: clamp(14px, 1.35vw, 17px);
    line-height: 1.55;
    text-wrap: pretty;
  }

  about-steps {
    display: block;
  }

  .about__steps {
    display: grid;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Each step moves further right: a staircase, one step at a time. */
  .about__step {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    align-items: center;
    gap: 26px;
    margin-left: calc(var(--step) * 48px);
  }

  .about__block {
    display: grid;
    width: 88px;
    height: 88px;
    place-items: center;
    background: var(--block);
    box-shadow: 8px 8px 0 var(--shadow);
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .about__block svg {
    display: block;
    width: 56px;
    height: 56px;
    overflow: visible;
  }

  .about__block rect {
    transform-box: fill-box;
    transform-origin: center;
    transition:
      opacity 260ms ease var(--delay),
      transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--delay);
  }

  about-steps[data-ready]:not([data-visible]) rect {
    opacity: 0;
    transform: scale(0);
  }

  .about__number {
    display: block;
    margin-bottom: 4px;
    color: #10a7bc;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
  }

  h3 {
    margin: 0 0 6px;
    color: #0b2e6b;
    font-size: clamp(22px, 2.2vw, 28px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .about__text p {
    max-width: 300px;
    margin: 0;
    color: #4b6593;
    font-size: 15px;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (hover: hover) {
    .about__step:hover .about__block {
      transform: translate(-3px, -3px);
      box-shadow: 11px 11px 0 var(--shadow);
    }
  }

  @media (max-width: 767px) {
    .about__eyebrow {
      margin-bottom: 8px;
      font-size: 10px;
      letter-spacing: 0.28em;
    }

    .about__rule {
      margin: 18px 0;
    }

    .about__steps {
      gap: 28px;
    }

    .about__step {
      grid-template-columns: 68px minmax(0, 1fr);
      gap: 20px;
      margin-left: calc(var(--step) * 14px);
    }

    .about__block {
      width: 68px;
      height: 68px;
      box-shadow: 6px 6px 0 var(--shadow);
    }

    .about__block svg {
      width: 42px;
      height: 42px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .about__block,
    .about__block rect {
      transition: none;
    }
  }
</style>

<script>
  class AboutSteps extends HTMLElement {
    private observer?: IntersectionObserver

    connectedCallback() {
      this.observer?.disconnect()
      this.toggleAttribute("data-ready", true)
      this.observer = new IntersectionObserver(
        entries => {
          if (!entries.some(entry => entry.isIntersecting)) return
          this.toggleAttribute("data-visible", true)
          this.observer?.disconnect()
        },
        { threshold: 0.35 },
      )
      this.observer.observe(this)
    }

    disconnectedCallback() {
      this.observer?.disconnect()
    }
  }

  if (!customElements.get("about-steps")) {
    customElements.define("about-steps", AboutSteps)
  }
</script>
