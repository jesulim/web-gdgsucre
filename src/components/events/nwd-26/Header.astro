---
import wtmLogo from "@/assets/events/md-26/wtm-logo.png"
import Avatar from "@/components/Avatar.astro"
import { type NavSection, NWD26_HOME_ANCHOR, NWD26_SECTIONS } from "@/data/nwd-26/nav"

interface Props {
  /**
   * Secciones del menú. Para agregar o reordenar una sección, edita
   * `src/data/nwd-26/nav.ts` — no hace falta tocar este archivo.
   */
  sections?: NavSection[]
  /**
   * Ruta de la landing del evento. Vacío (default) cuando el header ya está en
   * la landing y las anclas pueden ser del mismo documento. Cuando el header se
   * usa en otra página (registro, credencial), pasa la ruta de la landing para
   * que los links lleven allí en vez de apuntar a anclas inexistentes.
   */
  landingHref?: string
}

const { sections = NWD26_SECTIONS, landingHref = "" } = Astro.props

/** Convierte un ancla local en ruta absoluta cuando el header está fuera de la landing. */
const resolveHref = (href: string) =>
  landingHref && href.startsWith("#") ? `${landingHref}${href}` : href

/** Los href se resuelven una sola vez y ambos menús consumen la misma lista. */
const navItems = sections.map(section => ({ ...section, href: resolveHref(section.href) }))

const signInHref = `/api/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`

const linkBase =
  "text-[#345189] font-google font-medium hover:text-nwd-teal focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-nwd-yellow transition-colors no-underline"
const linkDesktop = `text-[13px] lg:text-sm ${linkBase}`
const linkMobile = `text-base ${linkBase} py-2 border-b border-[#E1E9F6] last:border-none`
---

<header
  class="sticky top-0 z-50 border-b border-[#E1E9F6]"
  style="background: rgba(246,248,252,0.88); backdrop-filter: blur(10px);"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-14 py-3.5 flex items-center justify-between gap-3 sm:gap-5"
  >
    <!-- Logo -->
    <a href={resolveHref(NWD26_HOME_ANCHOR)} class="flex items-center gap-3 no-underline text-nwd-ink">
      <img src={wtmLogo.src} alt="WTM Sucre" class="h-9 lg:h-10 w-auto block" />
      <div class="leading-[1.1] hidden min-[400px]:block">
        <div class="font-google font-semibold text-[13px] sm:text-sm whitespace-nowrap">Women Techmakers</div>
        <div class="font-google text-[11px] tracking-[2px] uppercase text-[#6B86B4]">
          Sucre
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7 ml-auto">
      {
        navItems.map((item) => (
          <a href={item.href} class={linkDesktop}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto md:ml-0 shrink-0">
      <Avatar eventSlug="nwd-26">
        <a
          href={signInHref}
          class="font-google font-semibold text-[13px] lg:text-sm text-white bg-nwd-blue hover:bg-nwd-blue-dark px-4 sm:px-5 py-2.5 rounded-full transition-colors no-underline"
        >Iniciar sesión</a>
      </Avatar>
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="menu-toggle"
      type="button"
      aria-label="Abrir menú"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="md:hidden flex flex-col justify-between w-6 h-3.5 text-nwd-ink focus:outline-none z-50 cursor-pointer"
    >
      <span
        class="w-full h-0.5 bg-current transition-all duration-300 origin-center line-1"
      ></span>
      <span class="w-full h-0.5 bg-current transition-all duration-300 line-2"
      ></span>
      <span
        class="w-full h-0.5 bg-current transition-all duration-300 origin-center line-3"
      ></span>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="absolute top-full left-0 w-full bg-nwd-paper border-b border-[#E1E9F6] transition-all duration-300 ease-in-out opacity-0 translate-y-2.5 pointer-events-none md:hidden flex flex-col py-6 px-6 gap-4 shadow-xl"
  >
    {
      navItems.map((item) => (
        <a href={item.href} class={linkMobile}>
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

if (menuToggle && mobileMenu) {
  /** Único lugar que abre o cierra el menú; el resto solo lo invoca. */
  const setMenu = (open: boolean) => {
    mobileMenu.classList.toggle("open", open);
    menuToggle.classList.toggle("open", open);
    menuToggle.setAttribute("aria-expanded", String(open));
    menuToggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };

  menuToggle.addEventListener("click", (e) => {
    e.stopPropagation();
    setMenu(!mobileMenu.classList.contains("open"));
  });

  // Cerrar al hacer click fuera del menú
  document.addEventListener("click", (event) => {
    const target = event.target as Node;
    if (
      mobileMenu.classList.contains("open") &&
      !mobileMenu.contains(target) &&
      !menuToggle.contains(target)
    ) {
      setMenu(false);
    }
  });

  // Cerrar al navegar a otra sección
  mobileMenu.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => setMenu(false));
  });
}
</script>

<style>
  #mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #menu-toggle.open .line-1 {
    transform: translateY(6px) rotate(45deg);
  }

  #menu-toggle.open .line-2 {
    opacity: 0;
    transform: scale(0);
  }

  #menu-toggle.open .line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
