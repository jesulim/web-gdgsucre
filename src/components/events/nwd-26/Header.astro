---
import wtmLogo from "@/assets/events/md-26/wtm-logo.png"
import Avatar from "@/components/Avatar.astro"

interface Section {
  href: string
  label: string
}

interface Props {
  sections?: Section[]
}

const { sections = [{ href: "#inicio", label: "Inicio" }] } = Astro.props
const signInHref = `/api/auth/signin?next=${encodeURIComponent(Astro.url.pathname)}`
const showSignInButton = false
---

<header
  class="sticky top-0 z-50 border-b border-[#E1E9F6]"
  style="background: rgba(246,248,252,0.88); backdrop-filter: blur(10px);"
>
  <div
    class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-14 py-3.5 flex items-center justify-between gap-3 sm:gap-5"
  >
    <!-- Logo -->
    <a href="#inicio" class="flex items-center gap-3 no-underline text-nwd-ink">
      <img src={wtmLogo.src} alt="WTM Sucre" class="h-9 lg:h-10 w-auto block" />
      <div class="leading-[1.1] hidden min-[400px]:block">
        <div class="font-google font-semibold text-[13px] sm:text-sm whitespace-nowrap">Women Techmakers</div>
        <div class="font-google text-[11px] tracking-[2px] uppercase text-[#6B86B4]">
          Sucre
        </div>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center gap-5 lg:gap-7 ml-auto">
      {
        sections.map((section) => (
          <a
            href={section.href}
            class="text-[13px] lg:text-sm text-[#345189] font-google font-medium hover:text-nwd-teal transition-colors no-underline"
          >
            {section.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto md:ml-0 shrink-0 flex items-center gap-3">
      <a
        href="#eventos-pasados"
        class="font-google font-semibold text-[13px] lg:text-sm text-nwd-blue border border-nwd-blue hover:bg-nwd-blue hover:text-white focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-nwd-yellow px-4 sm:px-5 py-2.5 rounded-full transition-colors no-underline"
      >Eventos pasados</a>
      {showSignInButton && (
        <Avatar eventSlug="nwd-26">
          <a
            href={signInHref}
            class="font-google font-semibold text-[13px] lg:text-sm text-white bg-nwd-blue hover:bg-nwd-blue-dark px-4 sm:px-5 py-2.5 rounded-full transition-colors no-underline"
          >Iniciar sesión</a>
        </Avatar>
      )}
    </div>

    <!-- Mobile Hamburger Button -->
    <button
      id="menu-toggle"
      class="md:hidden flex flex-col justify-between w-6 h-3.5 text-nwd-ink focus:outline-none z-50 cursor-pointer"
      aria-label="Abrir menú"
    >
      <span
        class="w-full h-0.5 bg-current transition-all duration-300 origin-center line-1"
      ></span>
      <span class="w-full h-0.5 bg-current transition-all duration-300 line-2"
      ></span>
      <span
        class="w-full h-0.5 bg-current transition-all duration-300 origin-center line-3"
      ></span>
    </button>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div
    id="mobile-menu"
    class="absolute top-full left-0 w-full bg-nwd-paper border-b border-[#E1E9F6] transition-all duration-300 ease-in-out opacity-0 translate-y-2.5 pointer-events-none md:hidden flex flex-col py-6 px-6 gap-4 shadow-xl"
  >
    {
      sections.map((section) => (
        <a
          href={section.href}
          class="text-base text-[#345189] font-google font-medium hover:text-nwd-teal transition-colors no-underline py-2 border-b border-[#E1E9F6] last:border-none"
        >
          {section.label}
        </a>
      ))
    }
    <a
      href="#eventos-pasados"
      class="text-base text-nwd-blue font-google font-semibold hover:text-nwd-teal focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-nwd-yellow transition-colors no-underline py-2"
    >Eventos pasados</a>
  </div>
</header>

<script>
  const menuToggle = document.getElementById("menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuToggle && mobileMenu) {
    // Toggle menu
    menuToggle.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = mobileMenu.classList.contains("open");

      if (isOpen) {
        mobileMenu.classList.remove("open");
        menuToggle.classList.remove("open");
      } else {
        mobileMenu.classList.add("open");
        menuToggle.classList.add("open");
      }
    });

    // Close menu when clicking outside
    document.addEventListener("click", (event) => {
      const target = event.target as Node;
      if (
        mobileMenu.classList.contains("open") &&
        !mobileMenu.contains(target) &&
        !menuToggle.contains(target)
      ) {
        mobileMenu.classList.remove("open");
        menuToggle.classList.remove("open");
      }
    });

    // Close menu when clicking a link
    const links = mobileMenu.querySelectorAll("a");
    links.forEach((link) => {
      link.addEventListener("click", () => {
        mobileMenu.classList.remove("open");
        menuToggle.classList.remove("open");
      });
    });
  }
</script>

<style>
  #mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  #menu-toggle.open .line-1 {
    transform: translateY(6px) rotate(45deg);
  }

  #menu-toggle.open .line-2 {
    opacity: 0;
    transform: scale(0);
  }

  #menu-toggle.open .line-3 {
    transform: translateY(-6px) rotate(-45deg);
  }
</style>
