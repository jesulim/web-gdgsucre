---
import Dino from "@/assets/events/devfest-26/dino2.svg"
import GDGSucre from "@/assets/logos/GDGSucreLogo.svg"
import Avatar from "@/components/Avatar.astro"

const navLinks = [{ name: "DevFest 2026", href: "#" }]

const accessToken = Astro.cookies.get("sb-access-token")?.value
---

<header id="header" class="fixed z-50 px-4 w-full h-16 flex items-center justify-between">
  <a id="logo" href="/#" class="pr-4 h-full flex items-center gap-4 text-xl mr-auto">
    <GDGSucre class="h-full" />

    <div class="hidden flex-col sm:flex">
      <span class="text-base leading-tight">Google Developer Group</span>
      <span class="text-sm">Sucre</span>
    </div>
    <span class="text-sm font-medium sm:hidden">GDG Sucre</span>

    <Dino class="ml-1 hidden h-13 opacity-90 lg:block" />
  </a>

  <nav
    id="mobile-menu"
    class="hidden absolute w-full top-full left-0 md:static md:flex md:items-center md:w-fit"
  >
    <ul
      class="flex flex-col m-2 p-4 gap-4 font-light border border-white/40 rounded-xl md:border-0 md:p-0 md:flex-row md:h-full md:items-center"
    >
      {
        navLinks.map(link => (
          <li>
            <a
              href={link.href}
              class="flex items-center gap-4 hover:underline font-medium hover:text-blue-500 transition-colors duration-200"
            >
              {link.name}
            </a>
          </li>
        ))
      }
      <a
        href="/eventos/"
        class="w-fit border-2 border-white/20 hover:border-white/40 hover:bg-white/10 font-medium text-sm lg:text-base px-4 py-2 rounded-full transition-colors duration-200"
      >
        Eventos Pasados
      </a>
    </ul>
  </nav>

  <div class="ml-4">
    {
      accessToken ? (
        <Avatar />
      ) : (
        <a
          href="/api/auth/signin"
          class="border-2 border-white/20 bg-white/20 rounded-full px-4 py-2 hover:bg-white/30 transition-colors"
        >
          Inicia sesión
        </a>
      )
    }
  </div>

  <div class="flex items-center gap-3 pl-4">
    <button id="menu-toggle" type="button" class="rounded md:hidden" aria-label="Abrir menú">
      <svg
        role="img"
        aria-labelledby="menu-toggle"
        class="size-6 stroke-black dark:stroke-white"
        fill="none"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
    </button>
  </div>
</header>

<div id="menu-overlay" class="fixed h-0 inset-0 z-40 bg-black/70 transition-all"></div>

<script>
  const header = document.getElementById("header")
  const logo = document.getElementById("logo")
  const menuToggle = document.getElementById("menu-toggle")
  const mobileMenu = document.getElementById("mobile-menu")
  const menuOverlay = document.getElementById("menu-overlay")

  function toggleMenu() {
    mobileMenu?.classList.toggle("hidden")

    menuToggle?.setAttribute(
      "aria-label",
      mobileMenu?.classList.contains("hidden") ? "Abrir menú" : "Cerrar menú",
    )

    menuOverlay?.classList.toggle("backdrop-blur-sm")
    menuOverlay?.classList.toggle("h-auto")
  }

  logo?.addEventListener("click", () => {
    if (mobileMenu?.classList.contains("hidden")) return
    toggleMenu()
  })
  menuToggle?.addEventListener("click", () => toggleMenu())
  menuOverlay?.addEventListener("click", () => toggleMenu())

  function updateHeader() {
    if (window.scrollY > 0) {
      header?.classList.add("backdrop-blur-sm")
    } else {
      header?.classList.remove("backdrop-blur-sm")
    }
  }

  window.addEventListener("scroll", updateHeader, { passive: true })
  updateHeader()
</script>
