---
import Dino from "@/assets/events/devfest-26/dino2.svg"
import GDGSucre from "@/assets/logos/GDGSucreLogo.svg"
import Avatar from "@/components/Avatar.astro"

const isLoggedIn = Astro.cookies.has("sb-access-token") || Astro.cookies.has("sb-refresh-token")

const navLinks = [
  { name: "Devfest 26", href: "/#hero" },
  // { name: "Paquetes", href: "/#seccion-paquetes" },
  // { name: "Sobre el evento", href: "/#about" },
  // { name: "Speakers", href: "/#speakers" },
  // { name: "Agenda", href: "/#agenda" },
  // { name: "Sponsors", href: "/#sponsors" },
  // { name: "Equipo", href: "/#organizadores" },
]

const registerHref = "/api/auth/signin?next=/registro/io-extended-25"
---

<nav
  id="site-header"
  class="fixed inset-x-0 top-0 z-20 flex w-full flex-row items-center justify-between gap-3 bg-transparent px-4 py-3 transition-[background-color,backdrop-filter] duration-300 sm:px-8 sm:py-4 lg:px-16 lg:py-5 xl:px-24 2xl:px-50"
>
  <!-- Logo -->
  <a href="/#" class="flex min-w-0 items-center gap-2 text-white sm:gap-3" aria-label="GDG Sucre, volver al inicio">
      <GDGSucre class="size-10 shrink-0 sm:size-16 lg:size-20" />
      <div class="hidden flex-col items-start justify-center sm:flex">
        <span class="text-base leading-tight lg:text-xl">Google Developer Group</span>
        <span class="text-xs text-white lg:text-sm">Sucre</span>
      </div>
      <span class="text-sm font-medium sm:hidden">GDG Sucre</span>
      <!-- <img src={Dino.src} alt="" aria-hidden="true" class="ml-1 hidden h-13 w-auto opacity-90 lg:block" /> -->
    </a>

  <!-- Botones / sesión -->
  <div class="flex justify-between items-center gap-4 h-10.25">
    <ul class="hidden items-center md:flex gap-12.25 h-8">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-white font-medium leading-6 pb-1 border-b-2 border-transparent hover:border-blue-500 hover:text-blue-500 transition-colors duration-200">
            {link.name}
          </a>
        </li>
      ))}
    </ul>
    <!-- Eventos Pasados (visible en desktop y móvil) -->
    <a href="https://gdgsucre.com/eventos/io-extended-25" class="hidden md:inline text-white border-2 border-white/20 hover:border-white/40 hover:bg-white/10 font-medium text-sm lg:text-base leading-5 lg:leading-6 px-4 lg:px-6 py-1.5 lg:py-[9px] rounded-full transition-colors duration-200">
      Eventos Pasados
    </a>

    <!-- Avatar o Login -->
    <!-- {isLoggedIn ? (
      <div class="relative">
        <Avatar eventSlug="devfest-26" />
      </div>
    ) : (
      <a 
      href={registerHref} 
      class="hidden rounded-full bg-io-accent px-5 py-1.5 text-sm font-medium leading-5 text-white transition-colors hover:bg-io-accent-hover md:inline lg:px-8 lg:py-[9px] lg:text-base lg:leading-6">
        Registrarme
      </a>
      <a
        href="{registerHref}"
        class="md:hidden inline-flex min-h-9 items-center justify-center rounded-full border border-white/60 bg-transparent px-3.5 py-2 text-sm font-medium leading-none text-white transition duration-200 hover:-translate-y-px md:bg-io-accent md:px-3.5 md:text-io-on-accent md:hover:bg-io-accent-hover"
      >
        Registrarme
      </a>
    )} -->

    <!-- Hamburguesa móvil -->
    <button
      id="menu-toggle"
      class="rounded p-2 text-white transition-colors md:hidden"
      aria-label="Abrir menú"
      aria-controls="mobile-menu"
      aria-expanded="false"
      type="button"
    >
      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Menú hamburguesa móvil -->
  <div id="mobile-menu" class="absolute left-0 top-full hidden w-full border rounded-2xl border-white/40 backdrop-blur-md px-6 py-4 shadow-md backdrop-blur-sm md:hidden">
    <ul class="flex flex-col gap-4">
      {navLinks.map(link => (
        <li>
          <a href={link.href} class="text-white text-lg font-medium hover:text-white transition-colors">
            {link.name}
          </a>
        </li>
      ))}
    </ul>
    <a href="https://devfest2024.gdgsucre.com/pastEvents/" class="mt-4 block text-white border-2 border-white/40 hover:border-white/40 hover:bg-white/10 text-center font-medium text-base leading-6 px-6 py-[9px] rounded-full transition-colors duration-200">
      Eventos Pasados
    </a>
  </div>
</nav>

<!-- Script funcional -->
<script type="module" is:inline>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');

  let isMenuOpen = false;

  const setMenuState = (open) => {
    if (!menuToggle || !mobileMenu) return;
    isMenuOpen = open;
    mobileMenu.classList.toggle('hidden', !open);
    menuToggle.setAttribute('aria-expanded', String(open));
    menuToggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
  };

  menuToggle?.addEventListener('click', () => {
    setMenuState(!isMenuOpen);
  });

  document.addEventListener('click', (e) => {
    if (isMenuOpen && mobileMenu && !menuToggle?.contains(e.target) && !mobileMenu.contains(e.target)) {
      setMenuState(false);
    }
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuState(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && isMenuOpen) setMenuState(false);
  });

  const siteHeader = document.getElementById('site-header');
  const updateHeaderOnScroll = () => {
    siteHeader?.classList.toggle('backdrop-blur-md', window.scrollY > 0);
    siteHeader?.classList.toggle('bg-black/10', window.scrollY > 0);
  };

  window.addEventListener('scroll', updateHeaderOnScroll, { passive: true });
  updateHeaderOnScroll();
</script>

