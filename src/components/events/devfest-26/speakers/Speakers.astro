---
import { Image } from "astro:assets"

import BracketOpen from "@/assets/events/devfest-26/BracketOpen.svg"
import Semicolon from "@/assets/events/devfest-26/semicolon.svg"

import brianImg from "@/assets/speakers/brian-castillo.webp"
import davidImg from "@/assets/speakers/david-rios.webp"
import sergioImg from "@/assets/speakers/sergio-ochoa.webp"
import yuryImg from "@/assets/speakers/yury-camacho.webp"

const speakers = [
  {
    role: "Android Technical Lead en Ualá",
    img: yuryImg,
    name: "Yury Camacho",
    title:
      "There Are No Strings on Me: Autonomous Mobile Agents with Direct Silicon Control (AI On-Device)",
  },
  {
    role: "Desarrollador móvil · GDG Lima",
    img: brianImg,
    name: "Brian Castillo",
    title: "Build Your Own Jarvis: Real-Time AI with Gemini Live API & Firebase",
  },
  {
    role: "Desarrollador de software especializado en Java",
    img: sergioImg,
    name: "Sergio Ochoa",
    title: "AI Harnesses: Más allá del prompting, ingeniería de software con agentes de IA",
  },
  {
    role: "Senior Mobile Developer · Flutter",
    img: davidImg,
    name: "David Rios",
    title: 'Login sin contraseña: El fin del "olvidé mi clave"',
  },
]

const speakerAccents = [
  "border-blue-400 text-blue-300",
  "border-yellow-400 text-yellow-300",
  "border-red-400 text-red-300",
  "border-green-400 text-green-300",
]
---

<section
  id="speakers"
  aria-labelledby="speakers-title"
  class="relative isolate scroll-mt-24 overflow-clip px-4 py-8 text-white md:py-12"
>
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0">
      <div class="absolute top-32 -left-4 size-40 rounded-full bg-yellow-500/30 blur-[45px] animation-delay-4000 sm:size-40 md:bottom-[40%] md:left-[6%] md:size-44 lg:size-56 lg:blur-[65px]"></div>
      <div class="absolute bottom-16 right-0 size-32 rounded-full bg-red-500/30 blur-[45px] sm:size-40 md:bottom-24 md:right-8 md:size-40 lg:size-48 lg:blur-[55px]"></div>
    </div>

    <div class="absolute top-1/5 left-4 hidden lg:block">
      <BracketOpen />
    </div>

    <div class="absolute bottom-4 right-8 hidden lg:block xl:right-20">
      <Semicolon />
    </div>
  </div>

  <div class="mx-auto max-w-5xl">
    <h2 id="speakers-title" class="mb-6 text-3xl font-bold tracking-tight md:mb-9 md:text-5xl">
      Speakers
    </h2>

    <ol class="max-w-3xl">
      {speakers.map(({ role, img, name, title }, index) => (
        <li class="group relative grid grid-cols-[1.5rem_0.75rem_minmax(0,1fr)] gap-x-2 pb-6 last:pb-0 sm:grid-cols-[2rem_0.75rem_minmax(0,1fr)] sm:gap-x-4 md:pb-8">
          <span
            aria-hidden="true"
            class:list={["pt-3.5 font-monospace text-xs tabular-nums", speakerAccents[index]]}
          >
            {String(index + 1).padStart(2, "0")}
          </span>

          <span aria-hidden="true" class="relative flex justify-center pt-4">
            <span class="absolute inset-x-1/2 top-5 -bottom-11 w-px bg-white/20 group-last:hidden md:-bottom-13"></span>
            <span class:list={["relative size-2.5 rounded-full border-2 bg-df-black", speakerAccents[index]]}></span>
          </span>

          <div class="min-w-0">
            <div class="flex items-center gap-3">
              <Image
                src={img}
                alt=""
                width={64}
                height={64}
                class="size-11 shrink-0 rounded-full border border-white/20 object-cover sm:size-12"
              />
              <div class="min-w-0">
                <h3 class="font-semibold leading-tight sm:text-lg">{name}</h3>
                <p class:list={["mt-0.5 text-xs font-medium sm:text-sm", speakerAccents[index]]}>
                  {role}
                </p>
              </div>
            </div>

            <p class="mt-2.5 wrap-break-word text-base font-medium leading-snug text-white sm:text-xl">
              {title}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
