---
import BracketOpen from "@/assets/events/devfest-26/BracketOpen.svg"
import Semicolon from "@/assets/events/devfest-26/semicolon.svg"

import brianImg from "@/assets/speakers/brian-castillo.webp"
import davidImg from "@/assets/speakers/david-rios.webp"
import sergioImg from "@/assets/speakers/sergio-ochoa.webp"
import yuryImg from "@/assets/speakers/yury-camacho.webp"

import { SpeakerCard } from "./SpeakerCard"

const speakers = [
  {
    img: yuryImg.src,
    name: "Yury Camacho",
    bio: "Ingeniero de Sistemas por la Universidad Mayor de San Simón de Cochabamba, Bolivia. Cuenta con experiencia en desarrollo móvil desde 2010, trabajando con plataformas como Symbian, BlackBerry, iOS y Android. También fue uno de los Google Glass Explorers. Es organizador de GDG Cochabamba y disfruta compartir conocimientos mediante charlas, talleres y mentorías. Actualmente se desempeña como Android Technical Lead en el equipo de Payments de Ualá, y ha trabajado en empresas como Globant, OLX y Rappi, además de desempeñarse como consultor independiente.",
    country: "🇦🇷🇧🇴 Argentina/Bolivia",
  },
  {
    img: brianImg.src,
    name: "Brian Castillo",
    bio: "Fundó y fue CTO de Wibo, startup con sede en Santiago de Chile, dedicada a mejorar la experiencia de compra en sitios web optimizando la eficiencia de los procesos de venta para generar engagement con los usuarios. Anteriormente, fundó y fue CTO de Horses Developer, fábrica de software en Lima, Perú, donde lideró y participó en proyectos móviles para clientes de Latinoamérica. Cuenta con más de 9 años de experiencia en tecnologías móviles, lo que lo llevó a involucrarse en las comunidades de Google Developer Groups (GDG). Actualmente, lidera y organiza los eventos del capítulo de GDG Lima, Perú.",
    country: "🇵🇪 Perú",
  },
  {
    img: sergioImg.src,
    name: "Sergio Ochoa",
    bio: "Ingeniero de Sistemas y desarrollador de software especializado en Java, sistemas empresariales y modernización de aplicaciones legadas. Con experiencia como instructor y expositor tecnológico, actualmente explora AI Harnesses, agentes de programación y metodologías de ingeniería asistida por IA para construir soluciones verificables y sostenibles.",
    country: "🇧🇴 Bolivia",
  },
  {
    img: davidImg.src,
    name: "David Rios",
    bio: "Senior Mobile Developer especializado en Flutter desde 2018, con experiencia construyendo apps para empresas internacionales en sectores como fintech y pagos digitales. Instructor de Flutter y organizador de comunidades tech en Bolivia como Flutter La Paz y GDG La Paz. Speaker en eventos como DevFest y FlutterConf Latam. Me apasiona compartir conocimiento y hacer crecer la comunidad.",
    country: "🇧🇴 Bolivia",
  },
]
---

<section id="speakers" class="relative isolate overflow-y-visible px-4 py-8 text-white md:py-12">
  <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
    <div class="absolute inset-0">
      <div class="absolute top-32 -left-4 size-40 rounded-full bg-yellow-500/30 blur-[45px] animation-delay-4000 sm:size-40 md:bottom-[40%] md:left-[6%] md:size-44 lg:size-56 lg:blur-[65px]"></div>
      <div class="absolute bottom-16 right-0 size-32 rounded-full bg-red-500/30 blur-[45px] sm:size-40 md:bottom-24 md:right-8 md:size-40 lg:size-48 lg:blur-[55px]"></div>
    </div>

    <div class="absolute top-1/5 left-4 hidden xl:block">
      <BracketOpen />
    </div>

    <div class="absolute bottom-4 right-8 hidden xl:block xl:right-20">
      <Semicolon />
    </div>
  </div>

  <div class="mx-auto max-w-6xl">
    <h2 class="text-3xl font-bold tracking-tight md:text-5xl mb-4 md:mb-8">Speakers</h2>

    <div class="grid gap-4 grid-cols-2 justify-items-center md:grid-cols-4">
      {speakers.map((speaker, i) => (
        <SpeakerCard {...speaker} index={i} client:visible />
      ))}
    </div>
  </div>
</section>
