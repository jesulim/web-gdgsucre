---
import { Image } from "astro:assets"

import Vector from "@/assets/events/devfest-26/Vector-10.svg"
import Numeral from "@/assets/events/devfest-26/Vector-25.svg"
import TenMinds from "@/assets/sponsors/10minds.webp"
import Cba from "@/assets/sponsors/cba.webp"
import Cca from "@/assets/sponsors/cca2.webp"
import JalaUDark from "@/assets/sponsors/jalau_dark.webp"
import Nible from "@/assets/sponsors/logo-nible-light.webp"
import Napp from "@/assets/sponsors/napp-dark.webp"
import Nova from "@/assets/sponsors/nova.webp"
import Vaquita from "@/assets/sponsors/vaquita-logo.webp"

const sponsors = [
  {
    name: "Cca",
    image: Cca,
    className: "max-w-52",
    href: "https://sucre.cca.edu.bo/",
  },
  {
    name: "Vaquita",
    image: Vaquita,
    className: "max-w-56",
    href: "https://vaquita.fi/",
  },
  {
    name: "Nible",
    image: Nible,
    className: "max-w-52",
    href: "https://nible.pro/",
  },
  { name: "Nova Computers", image: Nova, className: "max-w-52" },
  {
    name: "Fundación NAPP",
    image: Napp,
    className: "max-w-56",
    href: "https://fundacion-napp.org/",
  },
  {
    name: "10 Minds",
    image: TenMinds,
    className: "max-w-52",
    href: "https://10minds.org/",
  },
  { name: "Jala University", image: JalaUDark },
  { name: "Cba", image: Cba, className: "max-w-52" },
]
---

<section id="sponsors" class="relative isolate overflow-hidden p-4 text-white md:py-20">
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <div class="absolute -left-20 top-48 size-40 rounded-full bg-blue-500/25 blur-[70px] md:size-80"></div>
    <div class="absolute -right-20 bottom-20 size-48 rounded-full bg-green-500/20 blur-[75px] md:size-96"></div>

    <Numeral class="absolute -left-20 top-44 hidden size-72 opacity-70 lg:block" />
    <Vector class="absolute bottom-5 -right-50 hidden size-120 opacity-60 lg:block" />
  </div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <h2 class="text-3xl font-bold tracking-tight md:text-5xl mb-4 md:mb-8">Sponsors</h2>

    <div class="sponsors-border relative mx-auto rounded-4xl">
      <div class="grid grid-cols-2 lg:grid-cols-4 items-center gap-6 rounded-[calc(2rem-1px)] px-3 py-6 sm:min-h-64 sm:gap-5 sm:px-6 sm:py-10 md:px-10 md:py-10">
        {sponsors.map(sponsor => (
          <div class="flex min-w-0 min-h-24 items-center justify-center rounded-2xl px-2 py-2 sm:min-h-36 sm:px-2 sm:py-2">
            <a
              href={sponsor.href}
              target={sponsor.href ? "_blank" : undefined}
              rel={sponsor.href ? "noopener noreferrer" : undefined}
              class:list={[
                "flex w-full justify-center rounded-sm",
                sponsor.href &&
                  "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white",
              ]}
            >
              <Image
                src={sponsor.image}
                alt={`Logo de ${sponsor.name}`}
                class:list={["h-auto w-full object-contain", sponsor.className]}
              />
            </a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .sponsors-border::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 1px;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(110deg, #4285f4, #ea4335 42%, #fbbc04 68%, #34a853);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
  }
</style>
