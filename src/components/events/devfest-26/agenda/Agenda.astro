---
import { Image } from "astro:assets"
import { Coffee, Flag, Hand, Handshake, ScanLine } from "lucide-react"

import type { AgendaSlot } from "./agenda"
import { resolveAgendaSlotColors } from "./agenda"

interface Props {
  slots?: AgendaSlot[]
  title?: string
}

const { slots = [], title = "Agenda del Evento" } = Astro.props

const activityIcons = {
  "check-in": ScanLine,
  opening: Hand,
  sponsors: Handshake,
  break: Coffee,
  closing: Flag,
} satisfies Record<NonNullable<AgendaSlot["activity"]>, typeof Coffee>
---

<section
  id="agenda"
  aria-labelledby="agenda-title"
  class="scroll-mt-24 bg-df-black px-4 py-12 text-white md:py-16"
>
  <div class="mx-auto max-w-5xl">
    <div id="speakers" class="scroll-mt-24">
      <h2 id="agenda-title" class="mb-6 text-3xl font-bold tracking-tight md:mb-9 md:text-5xl">
        {title}
      </h2>
    </div>

    {slots.length > 0 ? (
      <ol class="[--time-width:8rem]" role="list">
        {slots.map(slot => {
          const { speakerName, speakerClass, titleClass } = resolveAgendaSlotColors(slot)
          const Icon = slot.activity && activityIcons[slot.activity]
          const [starts, ends] = slot.time.split(" - ")

          return (
            <li class="group grid grid-cols-[1.5rem_minmax(0,1fr)] gap-x-3 sm:gap-x-6 lg:grid-cols-[minmax(0,1fr)_var(--time-width)_1.5rem_minmax(0,1.45fr)]">
              <div class="col-start-2 row-start-1 flex items-baseline gap-2 pt-5 font-monospace tabular-nums lg:justify-end lg:pt-6">
                <span class="block text-base font-semibold leading-tight">
                  {ends ? <time datetime={starts}>{starts}</time> : slot.time}
                </span>
                {ends && (
                  <span class="block whitespace-nowrap text-xs leading-tight text-white/65 sm:text-sm">
                    <span aria-hidden="true">–</span><span class="sr-only">hasta </span>{" "}<time datetime={ends}>{ends}</time>
                  </span>
                )}
              </div>

              <span
                aria-hidden="true"
                class:list={[
                  "relative col-start-1 row-span-2 row-start-1 flex justify-center pt-4 lg:col-start-3 lg:row-span-1 lg:pt-5",
                  speakerClass ?? titleClass,
                ]}
              >
                <span class="absolute inset-x-1/2 top-7 -bottom-7 w-px bg-white/15 group-last:hidden lg:top-8 lg:-bottom-8"></span>
                <span class="relative grid size-6 place-items-center rounded-full bg-df-black">
                  {Icon ? (
                    <Icon size={17} strokeWidth={1.75} />
                  ) : (
                    <span class="size-2.5 rounded-full border-2 border-current"></span>
                  )}
                </span>
              </span>

              <div class:list={[
                "col-start-2 row-start-2 min-w-0 pt-1.5 pb-5 lg:row-start-1 lg:py-6",
                speakerName ? "lg:col-start-4" : "lg:col-start-1 lg:text-right",
              ]}>
                <h3 class:list={[
                  "wrap-break-word leading-snug",
                  speakerName
                    ? "text-base font-semibold md:text-xl"
                    : "text-sm font-medium text-white/85 md:text-base",
                ]}>
                  {slot.title}
                </h3>
                {speakerName && (
                  <div class="mt-1.5 flex min-w-0 items-center gap-2.5 lg:mt-2.5">
                    {slot.speakerImage && (
                      <Image
                        src={slot.speakerImage}
                        alt=""
                        width={96}
                        height={96}
                        class="hidden size-12 shrink-0 rounded-full border border-white/20 object-cover lg:block"
                      />
                    )}
                    <p class="text-sm font-medium leading-snug text-white/70 lg:text-base lg:text-white/85">{speakerName}</p>
                  </div>
                )}
              </div>
            </li>
          )
        })}
      </ol>
    ) : (
      <p class="border-y border-white/15 px-6 py-8 text-center text-white/70">Agenda por confirmar</p>
    )}
  </div>
</section>
