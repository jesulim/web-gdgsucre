---
import DevFest26Logo from "@/assets/events/devfest-26/logo.svg"
import Diagonal from "@/assets/events/devfest-26/Vector-7.svg"
import Mayor from "@/assets/events/devfest-26/Vector-20.svg"
import Menor from "@/assets/events/devfest-26/Vector-21.svg"
import Vector from "@/assets/events/devfest-26/Vector-23.svg"
import Equis from "@/assets/events/devfest-26/Vector-24.svg"
import CalendarIcon from "@/assets/logos/calendar-month.svg"
import LocationIcon from "@/assets/logos/distance.svg"
import { Timer } from "@/components/events/devfest-26/Timer"

const eventDate = new Date("2026-11-28T08:00:00-04:00")
const initialTime = eventDate.getTime() - Date.now()
---

<section
  id="hero"
  class="relative h-auto overflow-hidden bg-black pb-20 text-white"
>
<div class="absolute inset-0 overflow-hidden pointer-events-none z-0">
      <div
        class="absolute left-[-2rem] top-[-3rem] size-32 animate-pulse rounded-full bg-blue-500/50 blur-[45px] sm:size-40 md:left-[2%] md:top-[5%] md:size-44 lg:size-56 lg:blur-[65px]"
      >
      </div>

      <div
        class="absolute right-[1rem] top-8 size-32 animate-blob rounded-full bg-red-500/40 blur-[40px] animation-delay-2000 sm:size-40 md:right-[8%] md:top-[10%] md:size-40 lg:size-48 lg:blur-[55px]"
      >
      </div>

      <div
        class="absolute bottom-[60%] left-[2rem] size-32 animate-blob rounded-full bg-yellow-500/40 blur-[45px] animation-delay-4000 sm:size-40 md:bottom-[40%] md:left-[6%] md:size-44 lg:size-56 lg:blur-[65px]"
      >
      </div>

      <div
        class="absolute bottom-[50%] right-[0rem] size-32 animate-pulse rounded-full bg-green-500/45 blur-[45px] sm:size-40 md:bottom-[40%] md:right-[1%] md:size-40 lg:size-48 lg:blur-[55px]"
      >
      </div>
    </div>

    <div
      class="pointer-events-none absolute inset-0 z-[1] hidden lg:block"
      aria-hidden="true"
    >
      <img
        src={Diagonal.src}
        alt=""
        class="absolute left-[-15%] top-[3%] w-150 h-150 select-none"
      />
     
      <img
        src={Menor.src}
        alt=""
        class="absolute right-[13%] top-[14%] w-28.25 h-20.25 select-none"
      />
      <img
        src={Mayor.src}
        alt=""
        class="absolute right-[7%] top-[14%] w-28.25 h-20.25 select-none"
      />
      <img
        src={Equis.src}
        alt=""
        class="absolute bottom-[40%] left-[8%] w-50 h-50 select-none"
      />
      <img
        src={Vector.src}
        alt=""
        class="absolute bottom-[30%] right-[-7%] w-100 h-100 select-none"
      />
    </div>
<div class="relative flex min-h-100 flex-col items-center justify-start overflow-hidden px-4 pt-20 lg:min-h-250 lg:justify-center">

    <div
      class="relative z-10 mx-auto flex w-full max-w-4xl flex-col items-center"
    >
      <div
        class="pointer-events-none absolute left-1/2 top-[-5rem] -z-10 hidden size-[24rem] -translate-x-1/2 animate-pulse rounded-full bg-blue-500/25 blur-[90px] md:block md:size-[32rem] lg:top-[-8rem] lg:size-[40rem] lg:blur-[120px]"
        aria-hidden="true"
      >
      </div>

      <DevFest26Logo class="mx-auto w-[min(250px,78vw)] md:w-5/6 md:max-w-lg" />
      <p
        class="my-5 w-full max-w-[280px] text-center text-[20px] font-medium leading-[1.45] md:my-6 md:max-w-none md:text-[56px] md:font-bold md:leading-[1.35]"
      >
        Desarrolla y construye en la era de los agentes
      </p>

      <div class="font-medium rounded-full px-4 py-2 bg-white/20 w-fit mx-auto border-2 border-white/40 md:p-4 md:px-8">
        Regístro próximamente
      </div>

      <!-- <a
        href="#"
        class="io-glow mx-auto flex h-10 w-50 items-center justify-center rounded-[999px] bg-white px-4 py-2 text-[14px] font-semibold text-black transition-transform duration-200 hover:scale-105 active:scale-[0.98] motion-reduce:transition-none motion-reduce:hover:scale-100 md:h-18.75 md:w-68 md:bg-transparent md:px-9 md:py-4 md:text-[16px] md:font-medium md:text-white"
      >
        Regístro proximamente
      </a> -->

      <div
        class="my-8 flex justify-start w-fit max-w-full flex-col gap-4 text-[12px] md:w-fit md:flex-row md:gap-8 md:text-lg"
      >
        <div class="flex items-center justify-start gap-2 md:justify-center">
          <CalendarIcon aria-hidden="true" class="size-6 fill-white" />
          <span class="md:hidden">Sábado 28 de noviembre 8:00 a. m.</span>
          <span class="hidden md:inline">Sábado 28 de noviembre 08:00 a. m.</span>
        </div>
        <!-- <div class="flex items-center justify-start gap-2 md:justify-center">
          <LocationIcon aria-hidden="true" class="size-6 fill-white" />
          <span class="md:hidden">Facultad de Tecnología (por confirmar)</span>
          <span class="hidden md:inline">(Lugar por confirmar)</span>
        </div> -->
      </div>
    </div>
  </div>
   <div class="relative flex w-full justify-center">
    <Timer initialTime={initialTime} targetDate={eventDate} client:load />
  </div>
</section>
<style>
  :global(.timer-spectrum) {
    background-image: linear-gradient(
      90deg,
      #4285f4 0%,
      #ea4335 33%,
      #fbbc04 66%,
      #34a853 100%
    );
    background-size: 200% 100%;
    animation: io-glow-move 3s ease infinite;
  }

  .io-glow {
    position: relative;
  }

  .io-glow::before {
    content: "";
    position: absolute;
    inset: 0;
    padding: 2px;
    border-radius: inherit;
    pointer-events: none;
    background-image: radial-gradient(
      circle at center,
      #4285f4 10%,
      #ea4335 41%,
      #f9ab00 61%,
      #34a853 100%
    );
    background-size: 200% 200%;
    animation: io-glow-move 3s ease infinite;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
  }

  .io-glow:hover::before {
    animation-duration: 1.5s;
  }

  .io-glow:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 4px;
  }
  @keyframes io-glow-move {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }
  .animate-blob {
    animation: blob 7s ease-in-out infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }
  @keyframes blob {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(12px, -10px) scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.timer-spectrum),
    .io-glow::before,
    .animate-blob {
      animation: none;
    }
  }
</style>
