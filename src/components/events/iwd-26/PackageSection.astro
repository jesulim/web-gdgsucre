---
import { packages } from "@/data/iwd-26/packages"
import PackageCard from "./PackageCard.astro"
---

<section id="packages" class="relative overflow-hidden bg-white py-24 md:py-32">
  <div class="pointer-events-none absolute left-0 top-32 size-16 bg-[#1976D2]/10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute right-0 top-48 size-12 bg-[#10a7bc]/15" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto max-w-7xl px-6">
    <div class="mb-20 border-l-4 border-[#ebb842] pl-8">
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.3em] text-[#10a7bc]">Elige cómo participar</p>
      <h2 class="text-4xl font-bold leading-none tracking-tighter text-[#1976D2] md:text-6xl">Paquetes</h2>
      <div class="mt-4 h-1.5 w-24 rounded-full bg-[#ebb842]" aria-hidden="true"></div>
      <p class="mt-5 text-xl leading-relaxed text-gray-600 md:text-2xl">Conoce lo que incluye cada paquete.</p>
    </div>
    <div class="mx-auto grid max-w-[1280px] gap-7 md:grid-cols-2 xl:grid-cols-3 xl:items-stretch">
      {packages.map(packageData => <PackageCard packageData={packageData} />)}
    </div>
  </div>
</section>
