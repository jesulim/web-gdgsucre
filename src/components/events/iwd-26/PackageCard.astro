---
import Pattern from "@/assets/events/iwd-26/patrones.jpg"
import type { EventPackage } from "@/data/iwd-26/packages"
import { PackageFeatureIcon } from "./PackageFeatureIcon"

interface Props {
  packageData: EventPackage
}
const { packageData } = Astro.props
const accents = {
  blue: { price: "bg-[#1976D2] text-white", wash: "bg-[#1976D2]/[0.08]" },
  yellow: { price: "bg-[#ebb842] text-[#123b78]", wash: "bg-[#ebb842]/[0.14]" },
  turquoise: { price: "bg-[#10a7bc] text-white", wash: "bg-[#10a7bc]/[0.1]" },
}[packageData.accent]
---

<article class:list={["relative isolate flex min-h-[590px] flex-col overflow-hidden rounded-[1.65rem] border bg-white shadow-[0_12px_32px_rgba(17,62,120,0.08)]", packageData.featured ? "border-[#ebb842] shadow-[0_18px_40px_rgba(166,116,20,0.16)] lg:-translate-y-2" : "border-[#1976D2]/10"]}>
  <div class="h-2 w-full shrink-0 bg-cover bg-center" style={`background-image: url(${Pattern.src})`} aria-hidden="true"></div>
  <div class:list={["absolute right-8 top-12 size-4", packageData.featured ? "bg-[#ebb842]" : "bg-[#10a7bc]"]} aria-hidden="true"></div>
  <div class:list={["absolute right-16 top-28 size-2.5", packageData.featured ? "bg-[#1976D2]" : "bg-[#ebb842]"]} aria-hidden="true"></div>

  <div class="relative z-10 flex flex-1 flex-col px-6 pb-7 pt-6 sm:px-8">
    <p class="text-xs font-bold tracking-[0.24em] text-[#1976D2]">PAQUETE #{packageData.packageNumber}</p>
    <div class="relative mt-3 min-h-[218px]">
      <div class="relative z-10 max-w-[67%]">
        <h3 class="text-[2.25rem] font-bold leading-[0.88] tracking-[-0.055em] text-[#123b78] sm:text-[2.65rem]">{packageData.firstName}</h3>
        <p class="mt-1 font-serif text-[2.55rem] font-semibold italic leading-[0.85] tracking-[-0.065em] text-[#10a7bc] sm:text-[2.9rem]">{packageData.lastName}</p>
      </div>
      <div class:list={["absolute bottom-0 right-[-1rem] grid size-48 place-items-center rounded-full sm:size-52", accents.wash]} aria-hidden="true">
        <img src={packageData.image} alt={packageData.imageAlt} width="480" height="520" loading="lazy" decoding="async" class="relative z-10 h-[13.8rem] w-[13.8rem] object-contain object-bottom pointer-events-none select-none sm:h-60 sm:w-60" />
      </div>
    </div>
    <p class="mt-3 max-w-[18rem] text-base leading-relaxed text-slate-600">{packageData.description}</p>
    <div class="mt-4 h-1.5 w-14 rounded-full bg-[#ebb842]" aria-hidden="true"></div>
    <div class:list={["mt-6 inline-flex w-fit items-baseline rounded-xl px-5 py-3 font-bold shadow-sm", accents.price]}><span class="mr-2 text-lg">Bs.</span><span class="text-4xl leading-none tracking-[-0.05em]">{packageData.price}</span></div>
    <ul class:list={["mt-6 grid gap-3", packageData.id === "juana" && "mt-auto pb-2"]}>
      {packageData.features.map(feature => <li class="flex items-start gap-3 text-[0.95rem] font-medium leading-snug text-[#123b78]"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-[#1976D2]/[0.07]"><PackageFeatureIcon type={feature.type} /></span><span>{feature.label}</span></li>)}
    </ul>
  </div>
</article>

<style>
  @media (max-width: 639px) { article { min-height: 0; } }
</style>
