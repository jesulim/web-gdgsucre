---
import { Image } from "astro:assets"
import fernandoImg from "@/assets/events/bwai-26/speakers/fernando-silva.png"
import saulImg from "@/assets/events/bwai-26/speakers/saul-gutierrez-espada.png"
import silvanaImg from "@/assets/events/bwai-26/speakers/silvana-gutierrez-montano.png"
import type { Speaker } from "@/components/events/bwai-26/SpeakerCard.astro"
import SpeakerCard from "@/components/events/bwai-26/SpeakerCard.astro"

const logoSvg = "/events/bwai-26/logo-with-year.svg"

const speakers: Speaker[] = [
  {
    image: silvanaImg,
    name: "Silvana Gutierrez",
    roleChips: [],
    talkTitle: "Agentic Workflows: Orquestación de Agentes Autónomos",
    talkTitleSizeMobile: "text-2xl",
    talkTitleSizeDesktop: "lg:text-4xl",
    talkChips: [],
    talkIcon: "/events/bwai-26/speaker-icon-3.svg",
    description:
      "En esta sesión, profundizaremos en los Agentic Workflows y la Orquestación de Agentes, analizando cómo pasar de simples prompts a sistemas integrales que razonan, planifican y utilizan herramientas para resolver problemas complejos. Exploraremos la arquitectura técnica necesaria para que los agentes interactúen con el mundo real de forma autónoma, segura y escalable, transformando la manera en que concebimos el desarrollo de software moderno.",
  },
  {
    image: saulImg,
    name: "Saul Gutierrez",
    roleChips: [],
    talkTitle: "Data-Centric AI: Construyendo Agentes para la Preparación de Datos",
    talkTitleSizeMobile: "text-2xl",
    talkTitleSizeDesktop: "lg:text-4xl",
    talkChips: [],
    talkIcon: "/events/bwai-26/speaker-icon.svg",
    description:
      "En esta charla/taller no vamos a chatear con la IA, vamos a integrarla como un motor de procesamiento para resolver uno de los problemas del Machine Learning: la calidad de los datos.\n- Construiremos en Google Colab integrando la API de Gemini\n- Aplicaremos NLP para normalizar, estructurar y limpiar datasets con errores\n- Generaremos datasets de alta calidad, para mejorar la precisión de modelos de Machine Learning.",
  },

  {
    image: fernandoImg,
    name: "Fernando Silva",
    roleChips: [],
    talkTitle: "Agentes con Ollama - Agentic RAG - ReACT Agent (Reason + Act)",
    talkTitleSizeMobile: "text-2xl",
    talkTitleSizeDesktop: "lg:text-4xl",
    talkChips: [],
    talkIcon: "/events/bwai-26/speaker-icon-2.svg",
    description:
      "Tres charlas para sumergirte en el mundo de los agentes de IA. Agentes locales con Ollama: sistemas que razonan y actúan de forma autónoma desde tu propia máquina, sin depender de la nube.\nAgentic RAG: agentes que no solo recuperan información, sino que gestionan todo el proceso de búsqueda y respuesta para resolver problemas complejos. ReACT: el paradigma que combina razonamiento y acción en ciclos iterativos para resolver tareas paso a paso con mayor precisión.",
  },
]
---

<section
  class="w-full flex flex-col items-start px-5 py-8 gap-2 lg:px-20 lg:py-24 lg:gap-16"
>
  <h2
    class="bg-white border-2 border-black rounded-xs md:rounded-lg px-2 py-1 text-xs font-bold lg:px-10 lg:py-4 lg:text-4xl"
  >
    SPEAKERS
  </h2>

  <h3 class="text-4xl lg:text-6xl font-bold tracking-tight">
    Conoce a las mentes detrás de la innovación
  </h3>

  <div class="flex flex-col items-center w-full lg:p-5 gap-2 lg:gap-16">
    {speakers.map((speaker, i) => (
      <SpeakerCard speaker={speaker} index={i} logoSvg={logoSvg} />
    ))}
  </div>
</section>