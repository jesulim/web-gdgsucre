---
const sponsor1 = "/assets/figma/SponsorSIB.svg"
const sponsor2 = "/assets/figma/SponsorCISISH.svg"
const sponsor3 = "/assets/figma/SponsorNAPP.svg"
const sponsor4 = "/assets/figma/Sponsor10MINDS.svg"
---

<section class="w-full flex flex-col items-start px-5 py-8 gap-4 lg:px-20 lg:py-24 lg:gap-16">
    <h2 class="bg-white border-2 border-black rounded-xs md:rounded-lg px-2 py-1 text-xs font-bold lg:px-10 lg:py-4 lg:text-4xl">
        SPONSORS
    </h2>

    <div class="flex flex-col gap-4 lg:gap-16 w-full">
        <div class="flex flex-col gap-2 lg:gap-6">
            <h2 class="font-bold text-4xl tracking-tight leading-tight lg:text-6xl">Quienes hacen esto posible</h2>
        </div>
    </div>

    <div class="flex flex-wrap justify-center gap-8 lg:gap-16 w-full">

        <img src={sponsor1} alt="Sponsor 1">
        <img src={sponsor2} alt="Sponsor 2">
        <img src={sponsor3} alt="Sponsor 3">
        <img src={sponsor4} alt="Sponsor 4">

    </div>

</section>
