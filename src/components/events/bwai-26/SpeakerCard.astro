---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

export interface Speaker {
  image: ImageMetadata
  name: string
  roleChips?: string[]
  talkTitle: string
  talkTitleSizeMobile: string
  talkTitleSizeDesktop: string
  talkChips?: string[]
  talkIcon: string
  description: string
}

interface Props {
  speaker: Speaker
  index: number
  logoSvg: string
}

const { speaker, index, logoSvg } = Astro.props
---

<div class="flex flex-col lg:flex-row gap-12 w-full items-center justify-center">

  <div class="flex flex-col items-center gap-6">
    <div class="hidden lg:block lg:w-107 border-2 border-black rounded-4xl">
      <Image
        class="w-full rounded-4xl"
        src={speaker.image}
        alt={speaker.name}
        width={428}
      />
    </div>

    <div class="hidden lg:flex flex-col items-center gap-6">
      <div class="text-center bg-blue-500 text-white font-bold text-3xl w-94 px-5 py-5 rounded-3xl border-2 border-black">
        {speaker.name}
      </div>
      {speaker.roleChips && speaker.roleChips.length > 0 && (
        <ul class="flex gap-4 items-center flex-wrap justify-center">
          {speaker.roleChips.map((chip) => (
            <li class="text-xl font-medium border-2 border-black rounded-[10px] px-4 py-1 bg-white">
              {chip}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="flex flex-col gap-8">
    <div class="flex gap-12">
      <div class="flex flex-col gap-8 w-full">

        <div class="relative w-full lg:min-h-55">
          <div class="absolute inset-0 bg-[#D4D4D4] border-2 border-black rounded-xl translate-x-2.5 translate-y-2">
            <div class="border-b-2 border-black h-8"></div>
          </div>

          <div class="relative bg-white border-2 border-black rounded-xl overflow-hidden z-10 min-h-55 flex flex-col">
            <div class="border-b-2 border-black h-8 flex items-center px-3 gap-1.5 w-full">
              <span class="size-3 rounded-full bg-red-500 border-2 border-black"></span>
              <span class="size-3 rounded-full bg-yellow-500 border-2 border-black"></span>
              <span class="size-3 rounded-full bg-green-500 border-2 border-black"></span>
            </div>

            <div
              id={`speaker-trigger-${index}`}
              class="flex gap-4 py-4 px-3 lg:px-12 lg:py-10 justify-center items-center h-full flex-1 lg:cursor-default cursor-pointer"
            >
              <div class="relative lg:hidden shrink-0">
                <Image
                  class="w-40 rounded-2xl border-2 border-black"
                  src={speaker.image}
                  alt={speaker.name}
                  width={428}
                />
                <p class="absolute bottom-0 left-0 right-0 text-center bg-blue-500/80 text-white rounded-b-2xl px-2 py-2 text-sm font-bold">
                  {speaker.name}
                </p>
              </div>

              <p class={`${speaker.talkTitleSizeMobile} ${speaker.talkTitleSizeDesktop} font-bold lg:text-center max-w-100 lg:leading-11 whitespace-pre-line`}>
                {speaker.talkTitle}
              </p>
            </div>
          </div>
        </div>

        {speaker.talkChips && speaker.talkChips.length > 0 && (
          <ul class="hidden lg:flex gap-4 justify-center">
            {speaker.talkChips.map((chip) => (
              <li class="min-w-45 text-center text-lg font-medium border-2 border-black rounded-full px-4 bg-[#E7EFFE]">
                {chip}
              </li>
            ))}
          </ul>
        )}
      </div>

      <img src={speaker.talkIcon} class="hidden lg:block lg:w-70" alt="" />
    </div>

    <div class="hidden lg:flex max-w-178 flex-col">
      <p class="text-xl font-medium border-2 py-4 px-6 border-black rounded-4xl bg-white whitespace-pre-line">
        {speaker.description}
      </p>
      <img class="mt-4 self-end" src={logoSvg} alt="" />
    </div>
  </div>

</div>

<dialog
  id={`speaker-dialog-${index}`}
  class="lg:hidden m-auto w-[90vw] max-w-sm rounded-3xl border-2 border-black p-0 backdrop:bg-black/50"
>
  <div class="flex flex-col gap-4 p-6">
    <div class="flex items-center justify-between gap-4">
      <span class="font-bold text-lg">{speaker.talkTitle}</span>
      <button
        id={`speaker-close-${index}`}
        class="size-8 shrink-0 flex items-center justify-center rounded-full border-2 border-black font-bold"
      >
        ×
      </button>
    </div>
    <p class="text-base font-medium whitespace-pre-line">{speaker.description}</p>
  </div>
</dialog>

<script define:vars={{ index }}>
  const trigger = document.getElementById(`speaker-trigger-${index}`);
  const dialog = document.getElementById(`speaker-dialog-${index}`);
  const closeBtn = document.getElementById(`speaker-close-${index}`);

  trigger?.addEventListener("click", () => {
    if (window.innerWidth < 1024) dialog?.showModal();
  });

  closeBtn?.addEventListener("click", () => dialog?.close());

  dialog?.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
</script>