---
import AvatarMenu from "@/components/AvatarMenu"

import { getProfile, getStaffRoles } from "@/lib/services/profileService"
import { getEventRegistration } from "@/lib/services/registrationService"
import { createSupabaseServerClient, createUserClient } from "@/lib/supabase"

let userInitials = ""

const supabase = createSupabaseServerClient({ request: Astro.request, cookies: Astro.cookies })
const profile = await getProfile(supabase)

if (!profile) {
  return null
}

const names = profile?.first_name ? profile.first_name.trim().split(" ") : []
if (names.length > 1 && names[0] && names[1]) {
  userInitials = (names[0][0] + names[1][0]).toUpperCase()
} else if (names.length === 1 && names[0]) {
  userInitials = names[0][0].toUpperCase()
} else {
  userInitials = "U"
}

const { eventSlug = "io-extended-26" } = Astro.props
const registration = profile?.id
  ? await getEventRegistration(supabase, profile.id, eventSlug)
  : null

let staffRoles = {}
if (profile?.id && !profile?.is_admin) {
  staffRoles = await getStaffRoles(supabase, profile.id)
}
---

<AvatarMenu
  avatarUrl={profile?.avatar_url}
  userName={profile?.first_name || profile?.email || "Usuario"}
  userInitials={userInitials}
  email={profile?.email || ""}
  admin={profile?.is_admin || Object.keys(staffRoles).length > 0}
  registered={!!registration}
  eventSlug={eventSlug}
  client:load
/>
