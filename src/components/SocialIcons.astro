---
import { wtmSocialLinks } from "@/data/wtm-social-links"

const { class: className = "", ...props } = Astro.props
---

<div class={`flex items-center gap-4 ${className}`} {...props}>
  {
    wtmSocialLinks.map((link) => {
      const Icon = link.icon
      return (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.ariaLabel}
          class="text-white/70 hover:text-white transition-colors"
        >
          <Icon class="w-5 h-5" />
        </a>
      )
    })
  }
</div>
