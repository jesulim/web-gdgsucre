---
import ArrowOutward from "@/assets/icons/arrow_outward.svg"
import { getProfile } from "@/lib/services/profileService"
import { createUserClient } from "@/lib/supabase"
import ScrambledText from "./ScrambledText.astro"
import SuggestionsForm from "./SuggestionsForm"

let profile = null
const hasToken = Astro.cookies.has("sb-access-token")

if (hasToken) {
  const supabase = await createUserClient(Astro.cookies)
  profile = await getProfile(supabase)
}

const fullName = profile
  ? `${profile.first_name ?? ""} ${profile.last_name ?? ""}`.trim() || profile.email
  : null
---

<section id="sugerencias" class="flex flex-col gap-4 p-4 border-t-2 border-off-white mb-12">
  <div class="flex gap-2 items-baseline">
    <ScrambledText text="Sugerencias" />
    <span class="w-3 h-1 bg-red-500"></span>
  </div>

  <h2 class="text-3xl font-medium">¿Tienes ideas o sugerencias?</h2>
  <p class="opacity-90 max-w-2xl">
    Queremos seguir mejorando nuestra comunidad. Cuéntanos qué talleres, tecnologías, dinámicas o
    iniciativas te gustaría ver en las próximas actividades de GDG Sucre.
  </p>

  {
    profile ? (
      <SuggestionsForm
        client:visible
        user={{
          name: fullName,
          email: profile.email,
          avatarUrl: profile.avatar_url,
        }}
      />
    ) : (
      <div class="flex flex-col sm:flex-row items-center justify-between gap-6 p-6 border-2 border-off-white bg-off-white/10 dark:bg-black/30 rounded-sm">
        <div class="flex flex-col gap-1 text-center sm:text-left">
          <p class="text-lg font-medium">Inicia sesión para compartir tu sugerencia</p>
          <p class="text-sm opacity-80">
            Para evitar spam y dar seguimiento a tus aportes, requerimos inicio de sesión con Google.
          </p>
        </div>

        <a
          href="/api/auth/signin?next=/landing#sugerencias"
          class="group shrink-0 inline-flex items-center justify-between gap-3 bg-red-500 text-white font-monospace uppercase text-sm font-medium px-5 py-3 rounded-sm hover:bg-red-600 transition-colors"
        >
          Iniciar sesión con Google
          <ArrowOutward class="size-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform ease-in-out" />
        </a>
      </div>
    )
  }
</section>
