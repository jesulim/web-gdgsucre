---
import { Image } from "astro:assets"

import Bwai26 from "@/assets/events/bwai-26.webp"
import DevFest25 from "@/assets/events/devfest-25.webp"
import IoExtended25 from "@/assets/events/io-extended-25.webp"

import ScrambledText from "./ScrambledText.astro"

const items = [
  {
    label: "Build with AI 26",
    description: "9 y 10 de mayo 2026",
    image: Bwai26,
    href: "/eventos/bwai-26",
  },
  {
    label: "DevFest 25",
    description: "15 de noviembre 2025",
    image: DevFest25,
    href: "/eventos/devfest-25",
  },
  {
    label: "IO Extended 25",
    image: IoExtended25,
    description: "9 de agosto 2025",
    href: "/eventos/io-extended-25",
  },
]
---

<section id="featured" class="px-4 flex flex-col gap-4 mb-12">
  <div class="flex gap-2 items-baseline">
    <ScrambledText text="Destacados" />
    <span class="w-3 h-1 bg-yellow-500"></span>
  </div>

  <h2 class="text-3xl font-medium">Explora nuestros anteriores eventos</h2>

  <div class="flex flex-col md:flex-row border-y-2 border-off-white">
    <a id="display-image-link" href={items[0].href} class="p-4 border-r border-off-white md:order-2">
      <Image
        id="display-image"
        src={items[0].image}
        alt={items[0].label}
        width={1920}
        height={1080}
      />
    </a>

    <div class="flex flex-col w-full border-r-2 border-off-white">
      {
        items.map((item, index) => (
          <button
            data-image={item.image.src}
            data-link={item.href}
            class={`sidebar-btn text-left p-4 transition-colors border-yellow-500
              ${index === 0 ? "border-t-2 bg-yellow-pastel " : "text-gray-700 hover:bg-off-white"}`}
          >
            <p class="text-lg font-medium">{item.label}</p>
            <p class="text-gray-500">{item.description}</p>
          </button>
        ))
      }
    </div>
  </div>

  <script>
    function setupImageSwitcher() {
      const buttons = document.querySelectorAll(".sidebar-btn")
      const displayImage = document.getElementById("display-image") as HTMLImageElement
      const displayImageLink = document.getElementById("display-image-link") as HTMLAnchorElement

      if (!displayImage) return

      buttons.forEach(button => {
        button.addEventListener("click", () => {
          const newSrc = button.getAttribute("data-image")

          if (!newSrc || displayImage.src === newSrc) return

          displayImage.src = newSrc
          displayImage.alt = button.textContent?.trim() || ""
          displayImageLink.href = button.getAttribute("data-link") || "/eventos"

          buttons.forEach(btn => {
            btn.classList.remove("bg-yellow-pastel", "border-t-2")
            btn.classList.add("bg-white", "hover:bg-off-white")
          })

          button.classList.remove("bg-white", "hover:bg-off-white")
          button.classList.add("bg-yellow-pastel", "border-t-2")
        })
      })
    }

    // Initialize on first load
    setupImageSwitcher()
  </script>
</section>
