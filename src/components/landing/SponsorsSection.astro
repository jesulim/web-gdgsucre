---
import ArrowOutward from "@/assets/icons/arrow_outward.svg"
import ScrambledText from "@/components/landing/ScrambledText.astro"
import SponsorLogo from "@/components/sponsors/SponsorLogo.astro"
import { FEATURED_SPONSORS, SPONSORS } from "@/lib/data/sponsors"
---

<section id="sponsors" class="flex flex-col gap-4 border-t-2 border-off-white pt-8 mb-12">
  <div class="px-4 flex gap-2 items-baseline">
    <ScrambledText text="Sponsors" />
    <span class="w-3 h-1 bg-red-500"></span>
  </div>

  <h2 class="px-4 text-3xl font-medium text-balance">
    Empresas e instituciones que impulsan la comunidad
  </h2>

  <p class="px-4 max-w-3xl opacity-90 text-pretty">
    {SPONSORS.length} organizaciones han respaldado nuestras charlas, talleres y conferencias
    anuales en Sucre para mantener el conocimiento tecnológico abierto y gratuito.
  </p>

  <div class="grid grid-cols-2 sm:grid-cols-4 border-t-2 border-off-white">
    {
      FEATURED_SPONSORS.map(sponsor => (
        <div class="flex items-center justify-center p-4 sm:p-6 border-b-2 border-r-2 even:border-r-0 sm:even:border-r-2 sm:[&:nth-child(4n)]:border-r-0 border-off-white min-h-32 sm:min-h-36">
          <SponsorLogo
            sponsor={sponsor}
            stageClass="h-22 sm:h-24 p-2.5 sm:p-3"
            imgClass="max-h-14 sm:max-h-16 w-auto max-w-full"
          />
        </div>
      ))
    }
  </div>

  <div class="px-4 pt-2 flex flex-col md:flex-row md:items-center md:justify-between gap-4">
    <div class="flex flex-col gap-1">
      <p class="font-monospace text-xs uppercase tracking-widest opacity-80">
        Alianzas todo el año · 386+ asistentes en eventos insignia
      </p>
      <p class="text-base opacity-90 text-pretty">
        ¿Tu marca quiere conectar con desarrolladores, estudiantes y talento tech de Sucre?
      </p>
    </div>

    <a
      href="/sponsors"
      class="group w-full md:w-auto md:min-w-80 flex items-center justify-between gap-4 bg-blue-500 text-black p-4 rounded-sm uppercase font-monospace font-light hover:bg-green-500 transition-colors"
    >
      <span>Conoce a nuestros sponsors</span>
      <ArrowOutward
        aria-hidden="true"
        class="size-5 shrink-0 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform ease-in-out"
      />
    </a>
  </div>
</section>
