---
import ArrowOutward from "@/assets/icons/arrow_outward.svg"
import { getProfile, getStaffRoles } from "@/lib/services/profileService"
import { createUserClient } from "@/lib/supabase"
import AvatarDropdown from "./AvatarDropdown"

let userInitials = ""

const supabase = await createUserClient(Astro.cookies)
const profile = await getProfile(supabase)
const staffRoles = await getStaffRoles(supabase, profile?.id)

const names = profile?.first_name?.trim().split(/\s+/).filter(Boolean) ?? []
if (names.length > 1) {
  userInitials = (names[0][0] + names[1][0]).toUpperCase()
} else if (names.length === 1) {
  userInitials = names[0][0].toUpperCase()
}
---

<li class="pl-4 h-full flex items-center md:hidden">
  <a href="/perfil" class="flex items-center gap-4 font-monospace hover:underline">
    Mi Perfil
    {
      profile?.avatar_url && (
        <img
          class="size-6 rounded-full object-cover"
          src={profile.avatar_url}
          alt=""
          aria-hidden="true"
          width={24}
          height={24}
        />
      )
    }
  </a>
</li>
<li class="pl-4 h-full flex items-center md:hidden">
  <a href="/admin" class="flex items-center gap-4 font-monospace hover:underline">
    Admin <ArrowOutward class="size-5 fill-current" aria-hidden="true" />
  </a>
</li>
<li class="pl-4 h-full flex items-center md:hidden">
  <a
    href="/api/auth/signout"
    class="flex items-center gap-3 font-monospace text-red-500 hover:underline"
    aria-label="Cerrar sesión"
  >
    Cerrar Sesión
  </a>
</li>

<li class="hidden md:block pl-2 border-l-2 border-off-white h-full md:ml-2">
  <AvatarDropdown
    client:media="(min-width: 768px)"
    avatarUrl={profile?.avatar_url}
    userName={profile?.first_name}
    userInitials={userInitials}
    email={profile?.email}
    admin={profile?.is_admin || Object.keys(staffRoles).length > 0}
  />
</li>
