{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/calendario",
      "has": [
        {
          "type": "host",
          "value": "gdgsucre.com"
        }
      ],
      "destination": "https://calendario.gdgsucre.com",
      "permanent": true
    },
    {
      "source": "/calendario",
      "has": [
        {
          "type": "host",
          "value": "www.gdgsucre.com"
        }
      ],
      "destination": "https://calendario.gdgsucre.com",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "calendario.gdgsucre.com"
        }
      ],
      "destination": "/calendario"
    }
  ]
}
